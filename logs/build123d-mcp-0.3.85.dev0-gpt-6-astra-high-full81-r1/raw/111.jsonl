{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\nfrom pathlib import Path\np=Path('model.py')\ns=p.read_text()\nparams=s[:s.index('print(SlotArc.__doc__)')]\nprofiles=s[s.index('outer_sk ='):s.index('# Mounting ears:')]\nprofiles='\\\\n'.join(l for l in profiles.splitlines() if not l.startswith('body'))+'\\\\n'\nfeatures=s[s.index('# Axial drilled pattern'):s.index('# Correct the ear neck')]\nfeatures='\\\\n'.join(l for l in features.splitlines() if not l.startswith(('body=', 'show(', 'print(')))+'\\\\n'\nmain=s[s.index('# Correct the ear neck'):s.index('print(type(body).__name__)')]\nmain='\\\\n'.join(l for l in main.splitlines() if not l.startswith(('show(', 'detail_body=')))+'\\\\n'\nfinish='''\n# Stepped port mouths and small raised port lands.\nleftpads=[]\nfor yy in [uy,ly]:\n    leftpads.append(Pos(left_x-left_depth1/2+cut_margin/2,yy,side_hole_z)*Cylinder(left_boss_dia/2,left_depth1+cut_margin,rotation=(0,90,0)))\nbody=body.fuse(*leftpads)\nbody=body.cut(left_through,left_through_lower)\nfor yy in [uy,ly]:\n    body=body.cut(Pos(left_x-left_depth1,yy,side_hole_z)*Cylinder(left_outer_step/2,2*left_depth1,rotation=(0,90,0)))\nupper_mouth=Pos(right_flat-right_lip/2,-upper_port_drop,side_hole_z)*Cylinder(upper_port_od/2,right_lip+2*cut_margin,rotation=(0,90,0))\nlower_mouth=Pos(right_flat+right_lip/2,-lower_port_drop,side_hole_z)*Cylinder(lower_port_neck/2,right_lip+2*cut_margin,rotation=(0,90,0))\nbody=body.cut(upper_mouth,lower_mouth)\nrib_root_y=-lower_port_drop+small_relief_offset+small_relief_radius\nrib_end_y=rib_root_y+side_hole_z*math.tan(math.radians(side_groove_angle))\nrib_solids=[]\nfor zz in [0,thickness]:\n    rs=Plane.YZ*SlotArc(Line((rib_root_y,side_hole_z),(rib_end_y,zz)),fin_depth)\n    rib_solids.append(Pos(right_flat-cut_margin,0,0)*extrude(rs,amount=right_lip+cut_margin))\nrs=Plane.YZ*SlotArc(Line((-lower_port_drop,0),(-lower_port_drop,thickness)),fin_depth)\nrib_solids.append(Pos(right_flat-cut_margin,0,0)*extrude(rs,amount=right_lip+cut_margin))\ntrim_block=Pos(center_x,(uy+ly)/2,thickness/2)*Box(2*width_overall,2*height_overall,thickness)\nfor rr in rib_solids:\n    clipped=rr.intersect(trim_block)\n    body=body.fuse(*clipped)\nbody=body.cut(*right_through,lower_mouth)\nshow(body,'housing')\n'''\np.write_text(params+profiles+features+main+finish)\nprint('Saved canonical parameterized model:',p.stat().st_size,'bytes')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
