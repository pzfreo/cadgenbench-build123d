{"type":"item.started","item":{"id":"item_22","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"base_body = body\n# Axial drilled pattern and mounting apertures\naxial_cutters=[Pos(x,y,thickness/2)*Cylinder(bolt_dia/2,thickness+2*cut_margin) for x,y in bolt_points]\naxial_cutters.append(Pos(0,0,thickness/2)*Cylinder(eye_bore/2,thickness+2*cut_margin))\nleft_slot_center=(ear_slot_length/2,-ear_slot_length/2-ear_radius/2)\nleftslot=Pos(*left_slot_center)*SlotOverall(ear_slot_length,2*ear_radius,rotation=-ear_slot_angle*2)\nrightslot=Pos(right_flat-right_slot_length/2,-ear_radius/4)*SlotOverall(right_slot_length,2*ear_radius)\naxial_cutters += [Pos(0,0,-cut_margin)*extrude(s,amount=thickness+2*cut_margin) for s in [leftslot,rightslot]]\nbody=body.cut(*axial_cutters)\n# Follow the two pitch arcs with two independent rows of round-ended channels.\nrp=pitch_dia/2\nhalfarc=math.pi*rp\ntrack_length=2*halfarc+2*axis_separation\ndef track_s(x,y):\n    if y>=uy:\n        return rp*math.atan2(y-uy,x-center_x)\n    if y<=ly:\n        a=math.atan2(y-ly,x-center_x)\n        if a<0: a+=2*math.pi\n        return halfarc+axis_separation+rp*(a-math.pi)\n    if x<center_x: return halfarc+(uy-y)\n    return 2*halfarc+axis_separation+(y-ly)\nss=sorted([track_s(x,y) for x,y in bolt_points])\ndef band_point(s,r):\n    s=s%track_length\n    if s<=halfarc:\n        a=s/rp\n        return (center_x+r*math.cos(a),uy+r*math.sin(a))\n    if s<=halfarc+axis_separation:\n        return (center_x-r,uy-(s-halfarc))\n    if s<=2*halfarc+axis_separation:\n        a=math.pi+(s-halfarc-axis_separation)/rp\n        return (center_x+r*math.cos(a),ly+r*math.sin(a))\n    return (center_x+r,ly+s-2*halfarc-axis_separation)\ndef band_path(sa,sb,r):\n    cuts=[sa]+[v for v in [halfarc,halfarc+axis_separation,2*halfarc+axis_separation,track_length,track_length+halfarc] if sa<v<sb]+[sb]\n    es=[]\n    for a,b in zip(cuts[:-1],cuts[1:]):\n        m=(a+b)/2\n        p1,p2,pm=band_point(a,r),band_point(b,r),band_point(m,r)\n        t=m%track_length\n        if t<halfarc or halfarc+axis_separation<t<2*halfarc+axis_separation:\n            es.append(ThreePointArc(p1,pm,p2))\n        else: es.append(Line(p1,p2))\n    return Wire(es)\nchannels=[]\nfor r in [rp-channel_radial_offset,rp+channel_radial_offset]:\n    for i,sa in enumerate(ss):\n        sb=ss[(i+1)%bolt_count]\n        if sb<=sa: sb+=track_length\n        path=band_path(sa+channel_end_clearance,sb-channel_end_clearance,r)\n        channels.append(Pos(0,0,-cut_margin)*extrude(SlotArc(path,channel_width),amount=thickness+2*cut_margin))\nbody=body.cut(*channels)\nshow(body,'housing')"},"result":null,"error":null,"status":"in_progress"}}
