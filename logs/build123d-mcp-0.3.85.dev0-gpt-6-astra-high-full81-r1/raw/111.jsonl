_flat,-hole_y2))\\n    Polyline((right_flat,-hole_y2),(right_flat,-hole_y8),(hole_x4,-hole_y8),(hole_x4,uy),(hole_x3,0))\\nbody=body.fuse(extrude(make_face(right_wire.line),amount=thickness))\\nbody=body.cut(extrude(inner_sk,amount=thickness))\\nshow(body,'housing')\\n\\nbase_body = body\\n# Axial drilled pattern and mounting apertures\\naxial_cutters=[Pos(x,y,thickness/2)*Cylinder(bolt_dia/2,thickness+2*cut_margin) for x,y in bolt_points]\\naxial_cutters.append(Pos(0,0,thickness/2)*Cylinder(eye_bore/2,thickness+2*cut_margin))\\nleft_slot_center=(ear_slot_length/2,-ear_slot_length/2-ear_radius/2)\\nleftslot=Pos(*left_slot_center)*SlotOverall(ear_slot_length,2*ear_radius,rotation=-ear_slot_angle*2)\\nrightslot=Pos(right_flat-right_slot_length/2,-ear_radius/4)*SlotOverall(right_slot_length,2*ear_radius)\\naxial_cutters += [Pos(0,0,-cut_margin)*extrude(s,amount=thickness+2*cut_margin) for s in [leftslot,rightslot]]\\nbody=body.cut(*axial_cutters)\\n# Follow the two pitch arcs with two independent rows of round-ended channels.\\nrp=pitch_dia/2\\nhalfarc=math.pi*rp\\ntrack_length=2*halfarc+2*axis_separation\\ndef track_s(x,y):\\n    if y>=uy:\\n        return rp*math.atan2(y-uy,x-center_x)\\n    if y<=ly:\\n        a=math.atan2(y-ly,x-center_x)\\n        if a<0: a+=2*math.pi\\n        return halfarc+axis_separation+rp*(a-math.pi)\\n    if x<center_x: return halfarc+(uy-y)\\n    return 2*halfarc+axis_separation+(y-ly)\\nss=sorted([track_s(x,y) for x,y in bolt_points])\\ndef band_point(s,r):\\n    s=s%track_length\\n    if s<=halfarc:\\n        a=s/rp\\n        return (center_x+r*math.cos(a),uy+r*math.sin(a))\\n    if s<=halfarc+axis_separation:\\n        return (center_x-r,uy-(s-halfarc))\\n    if s<=2*halfarc+axis_separation:\\n        a=math.pi+(s-halfarc-axis_separation)/rp\\n        return (center_x+r*math.cos(a),ly+r*math.sin(a))\\n    return (center_x+r,ly+s-2*halfarc-axis_separation)\\ndef band_path(sa,sb,r):\\n    cuts=[sa]+[v for v in [halfarc,halfarc+axis_separation,2*halfarc+axis_separation,track_length,track_length+halfarc] if sa<v<sb]+[sb]\\n    es=[]\\n    for a,b in zip(cuts[:-1],cuts[1:]):\\n        m=(a+b)/2\\n        p1,p2,pm=band_point(a,r),band_point(b,r),band_point(m,r)\\n        t=m%track_length\\n        if t<halfarc or halfarc+axis_separation<t<2*halfarc+axis_separation:\\n            es.append(ThreePointArc(p1,pm,p2))\\n        else: es.append(Line(p1,p2))\\n    return Wire(es)\\nchannels=[]\\nfor r in [rp-channel_radial_offset,rp+channel_radial_offset]:\\n    for i,sa in enumerate(ss):\\n        sb=ss[(i+1)%bolt_count]\\n        if sb<=sa: sb+=track_length\\n        path=band_path(sa+channel_end_clearance,sb-channel_end_clearance,r)\\n        channels.append(Pos(0,0,-cut_margin)*extrude(SlotArc(path,channel_width),amount=thickness+2*cut_margin))\\nbody=body.cut(*channels)\\nshow(body,'housing')\\n\\nprint([(s.volume,tuple(s.bounding_box().min),tuple(s.bounding_box().max)) for s in body.solids()])\\n\\n# Correct the ear neck so its relief remains fully enclosed by the specified wall.\\nmain_body=extrude(outer_sk,amount=thickness).fuse(extrude(skirt,amount=thickness))\\nleft_outer=Pos(*left_slot_center)*SlotOverall(ear_slot_length+2*ear_wall,2*(ear_radius+ear_wall),rotation=-ear_slot_angle*2)\\nleft_eye=Circle(eye_od/2)\\nleft_cap=Pos(0,top_height/2)*Rectangle(eye_top_width,top_height)\\n# Neck fills a smooth connection from the relief envelope into the annular wall.\\nwith BuildLine() as bridge_wire:\\n    Spline((eye_top_width/2,0),(ear_blend_radius,-ear_radius),(hole_x6,-ear_radius),(hole_x5,uy+math.sqrt(outer_radius**2-(hole_x5-center_x)**2)))\\n    Polyline((hole_x5,uy+math.sqrt(outer_radius**2-(hole_x5-center_x)**2)),(hole_x6,-hole_y12),(ear_slot_length,-ear_slot_length),(eye_top_width/2,0))\\nleft_mount=extrude(left_outer+left_eye+left_cap+make_face(bridge_wire.line),amount=thickness)\\nmain_body=main_body.fuse(left_mount)\\n# Right ear's top and bottom lip blend into a flat side wall.\\nwith BuildLine() as rw:\\n    Spline((hole_x3,uy+math.sqrt(outer_radius**2-(hole_x3-center_x)**2)),(hole_x4,top_height-right_lip_height/2),(right_extreme-right_lip_offset,top_height))\\n    Polyline((right_extreme-right_lip_offset,top_height),(right_extreme,top_height),(right_extreme,top_height-right_lip_height))\\n    Spline((right_extreme,top_height-right_lip_height),(right_flat+right_wall_ref,0),(right_flat,-hole_y2))\\n    Polyline((right_flat,-hole_y2),(right_flat,-hole_y8),(hole_x4,-hole_y8),(hole_x4,uy),(hole_x3,uy+math.sqrt(outer_radius**2-(hole_x3-center_x)**2)))\\nmain_body=main_body.fuse(extrude(make_face(rw.line),amount=thickness)).cut(extrude(inner_sk,amount=thickness))\\nrightslot=Pos(right_flat-right_wall_ref-right_slot_length/2,-ear_radius/4)*SlotOverall(right_slot_length,2*ear_radius)\\naxial_cutters[-1]=Pos(0,0,-cut_margin)*extrude(rightslot,amount=thickness+2*cut_margin)\\nbody=main_body.cut(*axial_cutters)\\n# Keep a cast sleeve around the two lateral ports as channels cross their vicinity.\\nupper_sleeve=Pos(right_flat-left_depth4/2,-upper_port_drop,side_hole_z)*Cylinder(upper_port_od/2,left_depth4+2*cut_margin,rotation=(0,90,0))\\nlower_sleeve=Pos(right_flat-left_depth4/2,-lower_port_drop,side_hole_z)*Cylinder(lower_port_neck/2,left_depth4+2*cut_margin,rotation=(0,90,0))\\nprotected_channels=[ch.cut(upper_sleeve,lower_sleeve) for ch in channels]\\nbody=body.cut(*protected_channels)\\n# Cast port face stands 2.5 mm out from the side plane; buried base assures fusion.\\nport_face=Pos(right_flat-right_lip/2,-lower_port_drop,side_hole_z)*Cylinder(lower_port_od/2,3*right_lip,rotation=(0,90,0))\\nbody=body.fuse(port_face)\\n# Side drillings terminate at the central chamber, not through the opposite wall.\\nsidecut=[]\\nfor drop,dia in [(upper_port_drop,upper_port_bore),(lower_port_drop,lower_port_bore)]:\\n    sidecut.append(Pos(right_flat-left_depth4/2,-drop,side_hole_z)*Cylinder(dia/2,left_depth4+2*port_wall,rotation=(0,90,0)))\\nleft_x=center_x-outer_radius\\nfor yy in [uy,ly]:\\n    sidecut.append(Pos(left_x+left_depth4/2,yy,side_hole_z)*Cylinder(left_bore/2,left_depth4+2*cut_margin,rotation=(0,90,0)))\\n    sidecut.append(Pos(left_x+left_depth2/2,yy,side_hole_z)*Cylinder(left_step/2,left_depth2+2*cut_margin,rotation=(0,90,0)))\\n    sidecut.append(Pos(left_x+left_depth1/2,yy,side_hole_z)*Cylinder(left_outer_step/2,left_depth1+2*cut_margin,rotation=(0,90,0)))\\nfor zz in [zsmall1,zsmall2]:\\n    sidecut.append(Pos(left_x+left_depth4/2,-small_port_drop,zz)*Cylinder(small_drill/2,left_depth4+2*cut_margin,rotation=(0,90,0)))\\nbody=body.cut(*sidecut)\\n# Fine axial flutes along the lower flat, as visible in both broad and isometric views.\\nflutes=[]\\nfin_pitch=bottom_flat_width/fin_count\\nfor i in range(fin_count):\\n    xx=center_x-bottom_flat_width/2+(i+0.5)*fin_pitch\\n    flutes.append(Pos(xx,bottom_y+fin_depth/2-cut_margin/2,thickness/2)*Box(fin_pitch/2,fin_depth+cut_margin,thickness+2*cut_margin))\\nbody=body.cut(*flutes)\\nshow(body,'housing')\\n\\ndetail_body=body\\n# Upper right ear has a shallow rising cast roof, not the circular outline carried into the slot.\\ncap_start_y=uy+math.sqrt(outer_radius**2-(hole_x2-center_x)**2)\\nwith BuildLine() as capwire:\\n    Spline((hole_x2,cap_start_y),(hole_x3,top_height-right_lip_height),(right_extreme-right_lip_offset,top_height))\\n    Polyline((right_extreme-right_lip_offset,top_height),(right_extreme,top_height),(right_extreme,top_height-right_lip_height),(right_flat,-hole_y2),(hole_x3,-hole_y2),(hole_x2,cap_start_y))\\ncap=extrude(make_face(capwire.line),amount=thickness)\\ncap=cap.cut(extrude(inner_sk,amount=thickness),*axial_cutters,*protected_channels,*sidecut)\\nbody=body.fuse(cap)\\n# Continue lateral bores into the chamber; preserve the outer counterbores.\\nport_cut_length=right_flat-center_x\\nright_through=[Pos((right_flat+center_x)/2,-drop,side_hole_z)*Cylinder(dia/2,port_cut_length+2*port_wall,rotation=(0,90,0)) for drop,dia in [(upper_port_drop,upper_port_bore),(lower_port_drop,lower_port_bore)]]\\nleft_through=Pos((left_x+center_x)/2,uy,side_hole_z)*Cylinder(left_bore/2,center_x-left_x+2*cut_margin,rotation=(0,90,0))\\nleft_through_lower=Pos((left_x+center_x)/2,ly,side_hole_z)*Cylinder(small_drill/2,center_x-left_x+2*cut_margin,rotation=(0,90,0))\\nbody=body.cut(*right_through,left_through,left_through_lower)\\n# Cast pad above the lower lateral boss, R9 round-ended neck.\\nneck_sk=Plane.YZ*Pos(-lower_port_drop+small_relief_offset/2,side_hole_z)*SlotOverall(small_relief_offset+2*small_relief_radius,2*small_relief_radius)\\nneck=Pos(right_flat-cut_margin,0,0)*extrude(neck_sk,amount=right_lip+cut_margin)\\nbody=body.fuse(neck).cut(*right_through)\\n# Additional lower skirt channels follow the printed R81.5 construction centers.\\n# They remain separate from the two primary pitch bands.\\nlower_center_drop=212.3 # mm printed section ordinate\\nextra_channels=[]\\nfor xx,start in [(section_offset,180+bottom_angle),(section_offset+section_span,270)]:\\n    arc=CenterArc((xx,-lower_center_drop),bottom_radius,start,bottom_angle)\\n    extra_channels.append(Pos(0,0,-cut_margin)*extrude(SlotArc(arc,ear_wall),amount=thickness+2*cut_margin))\\nbody=body.cut(*extra_channels)\\nshow(body,'housing')\\n\\nprint(type(body).__name__)\\nprint(type(rib_solids[0]).__name__)\\nprint(type(rib_solids[0].intersect(trim_block)).__name__)\\nprint([(s.volume,tuple(s.bounding_box().size)) for s in body.solids()])\\n\\nfor rr in rib_solids:\\n    clipped=rr.intersect(trim_block)\\n    body=body.fuse(*clipped)\\nbody=body.cut(*right_through,lower_mouth)\\nshow(body,'housing')\",\n  \"blocks\": 7\n}"}},"error":null,"status":"completed"}}
