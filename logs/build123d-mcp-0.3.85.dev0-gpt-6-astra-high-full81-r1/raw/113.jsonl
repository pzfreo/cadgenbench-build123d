dth-right_fold-ba90/2\ncutout_y=step_low_y-cutout_straight\n# Plan blank reconstructed parametrically from printed stations.\np0=(lip_edge,notch_low)\np1=(lip_edge,notch_high)\ndef tangent(pt, upper):\n    dx=pt[0]-notch_center_x; dy=pt[1]-notch_y\n    a=math.atan2(dy,dx)\n    b=math.acos(notch_radius/math.hypot(dx,dy))\n    ang=a-b if upper else a+b\n    return (notch_center_x+notch_radius*math.cos(ang),notch_y+notch_radius*math.sin(ang))\nntop=tangent(p1,True); nbot=tangent(p0,False)\nwith BuildLine() as outline:\n    Polyline((zero,-hem_half_allowance),(lower_flange_end,-hem_half_allowance),(lower_flange_end,base_fold),(blank_width,base_fold),(blank_width,hem_to_top),(lip_edge,hem_to_top),p1,ntop)\n    ThreePointArc(ntop,(notch_center_x+notch_radius,notch_y),nbot)\n    Polyline(nbot,p0,(lip_edge,lip_start_y),(step_upper_x,lip_start_y),(step_upper_x,step_mid_y),(step_lower_x,step_mid_y),(step_lower_x,step_low_y),(datum_a,step_low_y),(datum_a,cutout_y))\n    CenterArc((cutout_center_x,cutout_y),cutout_radius,zero,-bend_angle)\n    Polyline((cutout_center_x,cutout_y-cutout_radius),(zero,cutout_y-cutout_radius),(zero,-hem_half_allowance))\nflat_face=Face(Wire(outline.edges()))\nflat=extrude(flat_face,amount=sheet_thickness)\ndef window(x0,x1,y0,y1):\n    return Pos(x0,y0,-sheet_thickness)*Box(x1-x0,y1-y0,sheet_thickness*3,align=(Align.MIN,Align.MIN,Align.MIN))\nbase=flat & window(zero,right_start,base_start,hem_to_top)\n# Trim two edge strips that will be bent to 45 degrees.\nlip_split=lip_fold+ba45/2\nbase=base-window(zero,lip_split,lip_start_y,notch_low)\nbase=base-window(zero,lip_split,notch_high,hem_to_top)\n# Straight portions of the two 90 degree flanges.\nright_panel=flat & window(right_fold+ba90/2,blank_width,base_start,hem_to_top)\nright_panel=right_panel.rotate(Axis((right_fold+ba90/2,zero,zero),(zero,1,zero)),-bend_angle).translate((right_start+outer_bend-(right_fold+ba90/2),zero,outer_bend))\nlower_panel=flat & window(zero,lower_flange_end,upper_tangent,lower_tangent)\nlower_panel=lower_panel.rotate(Axis((zero,lower_tangent,zero),(1,zero,zero)),-bend_angle).translate((zero,wall_y-lower_tangent,outer_bend))\n# Exact annular bend profiles in vertical planes.\ndef arc_section(center,r0,r1,start,sweep_angle,plane,length):\n    with BuildLine(plane) as ln:\n        a=CenterArc(center,r1,start,sweep_angle)\n        b=Line(a@1,(center[0]+r0*math.cos(math.radians(start+sweep_angle)),center[1]+r0*math.sin(math.radians(start+sweep_angle))))\n        c=CenterArc(center,r0,start+sweep_angle,-sweep_angle)\n        Line(c@1,a@0)\n    return extrude(Face(Wire(ln.edges())),amount=length,dir=plane.z_dir)\nright_bend=arc_section((right_start,outer_bend),bend_radius,outer_bend,-bend_angle,bend_angle,Plane(origin=(zero,hem_to_top,zero),x_dir=(1,zero,zero),z_dir=(zero,-1,zero)),hem_to_top-base_start)\nlower_bend=arc_section((base_start,outer_bend),bend_radius,outer_bend,-bend_angle,-bend_angle,Plane.YZ,lower_flange_end-datum_a).translate((datum_a,zero,zero))\nhem=arc_section((wall_y+hem_radius+sheet_thickness,wall_top),hem_radius,hem_radius+sheet_thickness,hem_angle,-hem_angle,Plane.YZ,lower_flange_end)\npart=base.fuse(right_panel,lower_panel,right_bend,lower_bend,hem)\n# 45 degree free-edge flanges, attached by curved bend sections.\nfor ya,yb in [(lip_start_y,notch_low),(notch_high,hem_to_top)]:\n    lp=flat & window(lip_edge,lip_fold-ba45/2,ya,yb)\n    lp=lp.rotate(Axis((lip_fold-ba45/2,zero,zero),(zero,1,zero)),lip_angle)\n    lx=lip_split-outer_bend*math.sin(math.radians(lip_angle))\n    lz=outer_bend*(1-math.cos(math.radians(lip_angle)))\n    lp=lp.translate((lx-(lip_fold-ba45/2),zero,lz))\n    lb=arc_section((lip_split,outer_bend),bend_radius,outer_bend,-bend_angle,-lip_angle,Plane(origin=(zero,yb,zero),x_dir=(1,zero,zero),z_dir=(zero,-1,zero)),yb-ya)\n    part=part.fuse(lp,lb)\n# Holes are placed using the same flat-to-folded coordinate map.\nfor yy in [hole_top_y-hole_span,hole_top_y-hole_pitch,hole_top_y]:\n    zh=outer_bend+hole_x-(right_fold+ba90/2)\n    drill=Pos(right_start+outer_bend-sheet_thickness/2,yy,zh)*Cylinder(hole_diameter/2,sheet_thickness*3,rotation=(zero,bend_angle,zero))\n    part=part.cut(drill)\npart=part.cut(Pos(small_hole_x,small_hole_y,zero)*Cylinder(small_hole_diameter/2,sheet_thickness*3))\npart=part.cut(Pos(lip_fold,lip_start_y,zero)*Cylinder(relief_diameter/2,sheet_thickness*3))\nshow(part,\"bracket\")\nprint(\"Derived bend spans:\",ba90,ba45,ba180,\"wall top\",wall_top,\"right height\",wall_height)\n"},"result":null,"error":null,"status":"in_progress"}}
