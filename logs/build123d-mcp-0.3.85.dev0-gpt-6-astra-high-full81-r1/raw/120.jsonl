52.0 # mm\nl_pocket_step=30.0 # mm\nshoulder_run=50.0 # mm, inferred undimensioned shoulder run\nroof_pocket_radius=15.0 # mm\nrim_band=10.0 # mm, inferred flange land\nwall=wall_min+pocket_depth\nhalf_body=body_width/2\nhalf_flange=flange_width/2\nhalf_length=body_length/2\nshoulder_z=overall_height-shoulder_run\nroof_half=half_body-shoulder_run\n# Rounded extruded side profile, open shell generated by inward offset\noutline=[(-half_body,0),(half_body,0),(half_body,shoulder_z),(roof_half,overall_height),(-roof_half,overall_height),(-half_body,shoulder_z)]\nprofile=Plane.XZ*Polygon(*outline,align=None)\nouter=extrude(profile,amount=half_length,both=True)\nround_edges=[e for e in outer.edges().filter_by(Axis.Y) if e.center().Z>rim_height]\nouter=fillet(round_edges,outer_radius)\nopening=outer.faces().sort_by(Axis.Z)[0]\nresult=offset(outer,amount=-wall,openings=opening)\n# Flange follows width of the open mating face\nflange=extrude(RectangleRounded(flange_width,body_length,outer_radius),amount=rim_height)\nflange_void=extrude(RectangleRounded(body_width-2*wall,body_length-2*wall,inner_radius),amount=rim_height)\nresult=result.fuse(flange-flange_void)\n# Side-wall mounting pads, buried into shell and terminating at Z=90\nside_positions=[(sx*side_boss_x,y) for sx in [-1,1] for y in side_boss_y]\nfor x,y in side_positions:\n pad=Pos(x,y,boss_tip_z)*extrude(RectangleRounded(2*boss_radius+wall,2*boss_radius, rib_radius),amount=shoulder_z-boss_tip_z)\n bridge=Pos((x+(half_body-wall/2)*(1 if x>0 else -1))/2,y,boss_tip_z)*Box(abs(half_body-wall/2-abs(x))+wall,2*boss_radius,shoulder_z-boss_tip_z,align=(Align.CENTER,Align.CENTER,Align.MIN))\n result=result.fuse(pad,bridge)\nroof_positions=[(roof_boss_x_left,roof_boss_top_y),(0,roof_boss_top_y),(roof_boss_x_right,roof_boss_top_y),(roof_boss_x_left,roof_boss_mid_y),(roof_mid_x,roof_boss_mid_y),(roof_boss_x_left,roof_boss_low_y),(roof_low_x,roof_boss_low_y),(roof_boss_x_right,roof_boss_low_y)]\nfor x,y in roof_positions:\n result=result.fuse(Pos(x,y,overall_height-wall-roof_boss_height)*Cylinder(boss_radius,roof_boss_height+wall_min,align=(Align.CENTER,Align.CENTER,Align.MIN)))\nshow(result,'housing')"},"result":null,"error":null,"status":"in_progress"}}
