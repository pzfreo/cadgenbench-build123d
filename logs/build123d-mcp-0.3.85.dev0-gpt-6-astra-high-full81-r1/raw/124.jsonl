{"type":"item.started","item":{"id":"item_41","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"# Refine the smaller pocket profiles around their dimensioned straight spans.\n# Bottom straight span is between fillet tangencies, not the theoretical sharp corners.\nlow_left_trim=pocket_radius/math.tan(theta/2)\nlow_right_trim=pocket_radius/math.tan(math.radians(cross_rib_angle)/2)\nlow_length=lower_bottom_span+low_left_trim+low_right_trim\nlow_a=Vector(small_root_x-low_left_trim,lower_y,0)\nlow_b=low_a+Vector(low_length,0,0)\nlow_c=low_a+u*(low_length*math.cos(theta))\nlower_pocket=Face(Wire.make_polygon([low_a,low_b,low_c],close=True))\nlower_pocket=lower_pocket.fillet_2d(pocket_radius,lower_pocket.vertices())\nright_c=Vector(right_wall_x,upper_y-boss_r-rim_width/2,0)\nright_b=Vector(right_wall_x,lower_y+boss_r,0)\nright_a=right_c-u*(right_diag_span+2*pocket_radius)\nright_pocket=Face(Wire.make_polygon([right_a,right_b,right_c],close=True))\nright_pocket=right_pocket.fillet_2d(pocket_radius,right_pocket.vertices())\n# Radius-constrained, tangent arcs between the end bosses.\nd=end_c-upper_c\nmid=(end_c+upper_c)/2\nperp=Vector(d.Y,-d.X,0).normalized()\nouter_ctr=mid+perp*math.sqrt((link_outer_radius-boss_r)**2-(d.length/2)**2)\ninner_ctr=mid+perp*math.sqrt((link_inner_radius+boss_r)**2-(d.length/2)**2)\nouter_a=outer_ctr+(upper_c-outer_ctr).normalized()*link_outer_radius\nouter_b=outer_ctr+(end_c-outer_ctr).normalized()*link_outer_radius\ninner_a=inner_ctr+(upper_c-inner_ctr).normalized()*link_inner_radius\ninner_b=inner_ctr+(end_c-inner_ctr).normalized()*link_inner_radius\nlink_face=face_edges([RadiusArc(outer_a,outer_b,link_outer_radius),Edge.make_line(outer_b,end_c),Edge.make_line(end_c,inner_b),RadiusArc(inner_b,inner_a,-link_inner_radius),Edge.make_line(inner_a,upper_c),Edge.make_line(upper_c,outer_a)])\n# Build the revised link and pockets from the same uncut primary body.\nbody=prism(main_face,body_width).fuse(Cylinder(hub_r,hub_width))\nfor c,w in [(lower_c,lower_boss_width),(upper_c,end_boss_width),(end_c,end_boss_width)]:\n    body=body.fuse(Pos(c)*Cylinder(boss_r,w))\nbody=body.fuse(prism(link_face,end_boss_width))\nlink_relief=prism(link_face,end_boss_width+joining_overlap)\nlink_relief=link_relief.cut(Pos(inner_ctr)*Cylinder(link_inner_radius+rim_width,hub_width))\nfor c in [upper_c,end_c]:\n    link_relief=link_relief.cut(Pos(c)*Cylinder(boss_r+rim_width,hub_width))\nfor sign in [-1,1]:\n    slab=Pos(end_x/2,upper_y,sign*(link_width/2+link_inset))*Box(end_x,hub_od,2*link_inset)\n    body=body.cut(link_relief.intersect(slab))\nfor pf in [main_pocket,lower_pocket,right_pocket]:\n    cutter=Pos(0,0,web_width/2)*extrude(pf,amount=pocket_depth+joining_overlap,dir=(0,0,1))\n    floor_edges=[e for e in cutter.edges() if abs(e.center().Z-web_width/2)<1e-5 and e.bounding_box().size.Z<1e-5]\n    cutter=fillet(floor_edges,radius=pocket_radius)\n    body=body.cut(cutter).cut(mirror(cutter,about=Plane.XY))\nbody=body.cut(Cylinder(hub_id/2,hub_width+joining_overlap))\nfor c in [lower_c,upper_c,end_c]:\n    body=body.cut(Pos(c)*Cylinder(boss_id/2,hub_width+joining_overlap))\nresult=body.clean()\nshow(result,'bracket')"},"result":null,"error":null,"status":"in_progress"}}
