{"type":"item.started","item":{"id":"item_30","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"# Three paired blind pockets; preserve the section's 10 mm central web.\ntheta=math.radians(rib_angle)\nu=Vector(math.cos(theta),math.sin(theta),0)\nv=Vector(-math.sin(theta),math.cos(theta),0)\nleft_low=Vector(main_left_radius,0,0)\nbottom_start=left_low+Vector(pocket_radius,-pocket_radius,0)\nbottom_end=bottom_start+Vector(main_bottom_radius*math.sin(theta),main_bottom_radius*(1-math.cos(theta)),0)\ndiag_end=bottom_end+u*main_diag_span\ntop_start=Vector(main_left_radius,body_width,0)\ntop_end=top_start+Vector(math.cos(math.radians(upper_pocket_angle)),math.sin(math.radians(upper_pocket_angle)),0)*main_top_span\nleft_high=Vector(main_left_radius*math.cos(theta),main_left_radius*math.sin(theta),0)\nmain_pocket=face_edges([Edge.make_line(top_start,top_end),Edge.make_line(top_end,diag_end),Edge.make_line(diag_end,bottom_end),RadiusArc(bottom_end,bottom_start,main_bottom_radius),RadiusArc(bottom_start,left_low,pocket_radius),RadiusArc(left_low,left_high,-main_left_radius),Edge.make_line(left_high,top_start)])\n# Round the remaining profile corners, leaving the pre-formed R31/R65 curves.\ntry:\n    corner_vertices=[vert for vert in main_pocket.vertices() if min((Vector(vert)-p).length for p in [top_start,top_end,diag_end,left_high])<exterior_radius]\n    main_pocket=main_pocket.fillet_2d(pocket_radius,corner_vertices)\nexcept Exception as exc:\n    print('main plan corner blend deferred',str(exc))\n# Lower triangular relief follows the dimensioned 30/60 degree directions.\nlow_a=Vector(small_root_x,lower_y,0)\nlow_b=low_a+Vector(lower_bottom_span+2*pocket_radius,0,0)\nlow_c=low_a+u*(lower_diag_span+2*pocket_radius)\nlower_pocket=Face(Wire.make_polygon([low_a,low_b,low_c],close=True))\nlower_pocket=lower_pocket.fillet_2d(pocket_radius,lower_pocket.vertices())\nright_b=Vector(right_wall_x,lower_y+boss_r+rim_width,0)\nright_c=right_b+Vector(0,right_normal_span+rim_width,0)\nright_a=right_c-u*(right_diag_span+rim_width)\nright_pocket=Face(Wire.make_polygon([right_a,right_b,right_c],close=True))\nright_pocket=right_pocket.fillet_2d(pocket_radius,right_pocket.vertices())\npocket_faces=[main_pocket,lower_pocket,right_pocket]\ncutters=[]\nfor pf in pocket_faces:\n    cutter=Pos(0,0,web_width/2)*extrude(pf,amount=pocket_depth+joining_overlap,dir=(0,0,1))\n    floor_edges=[e for e in cutter.edges() if abs(e.center().Z-web_width/2)<1e-5 and e.bounding_box().size.Z<1e-5]\n    try:\n        cutter=fillet(floor_edges,radius=pocket_radius)\n    except Exception as exc:\n        print('floor fillet deferred',str(exc))\n    cutters.extend([cutter,mirror(cutter,about=Plane.XY)])\nfor cutter in cutters:\n    body=body.cut(cutter)\nresult=body\nshow(result,'bracket')"},"result":null,"error":null,"status":"in_progress"}}
