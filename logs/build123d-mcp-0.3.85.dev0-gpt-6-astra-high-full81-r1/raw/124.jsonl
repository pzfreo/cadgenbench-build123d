review\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-operating-review\",\"title\":\"Operating Review\",\"description\":\"Create a presentation using the Operating Review template and its retained reference file. Use when the user selects or names Operating Review. Run weekly operating reviews with scorecards, functional updates, risks, decisions, and action items.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc048191b1dd87c6d0bb3190\",\"skill_name\":\"artifact-template-operating-review\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-kickoff\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-kickoff\",\"title\":\"Project Kickoff\",\"description\":\"Create a presentation using the Project Kickoff template and its retained reference file. Use when the user selects or names Project Kickoff. Align teams on project goals, scope, roles, milestones, risks, and the working model.\",\"mimeType\":\"mcp/skill\",\"_meta\":{\"plugin_id\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f\",\"plugin_name\":\"openai-templates\",\"plugin_release_id\":\"pluginrel_6a6ced4ebc8c8191bf7c17972c03db1c\",\"plugin_release_skill_id\":\"pluginrsk_6a6ced4fdc0c819183f2aba3389112f3\",\"skill_name\":\"artifact-template-project-kickoff\",\"contents\":[\"assets\"],\"allow_implicit_invocation\":false}},{\"server\":\"codex_apps\",\"uri\":\"skill://plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-tracker\",\"name\":\"plugin_connector_1p_2330815c823c8191941e5dc465bb899f/artifact-template-project-tracker\",\"title\":\"Project Tracker\",\"