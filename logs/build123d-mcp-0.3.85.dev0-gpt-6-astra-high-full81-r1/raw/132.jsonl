{"type":"item.started","item":{"id":"item_15","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"from build123d import *\nimport math\noverall_length = 140.0 # mm\nflange_diameter = 130.0 # mm\nflange_thickness = 5.0 # mm\ntube_diameter = 70.0 # mm\ntube_wall = 3.0 # mm, unspecified wall default\nneck_attachment_diameter = 80.0 # mm\nblend_attachment_diameter = 90.0 # mm\nlarge_blend_radius = 10.0 # mm\nneck_blend_radius = 5.0 # mm\nlobed_thickness = 12.0 # mm\nrecess_diameter = 70.0 # mm\nrecess_depth = 10.0 # mm\nrecess_floor_to_base = 130.0 # mm\nupper_flange_top_depth = 27.0 # mm\nupper_flange_bottom_depth = 32.0 # mm\ntube_upper_tangent_depth = 42.0 # mm\ntube_lower_tangent_depth = 125.0 # mm\nbottom_flange_top_depth = 135.0 # mm\nflange_hole_diameter = 8.0 # mm\nflange_hole_count = 12\nflange_bolt_radius = 55.0 # mm\nflange_ordinate_half = 27.50 # mm\nflange_ordinate_diagonal = 47.63 # mm\nlobe_hole_diameter = 10.0 # mm\nlobe_count = 6\nlobe_bolt_radius = 45.0 # mm\nlobe_ordinate_half = 22.50 # mm\nlobe_ordinate_diagonal = 38.97 # mm\nlobe_bolt_diameter = 90.0 # mm\nlobe_tip_span = 110.0 # mm\nlobe_radius = 10.0 # mm\nscallop_radius = 40.0 # mm\nscallop_valley_span = 87.25 # mm, rounded reference\nlobe_detail_span = 64.97 # mm, reference\nedge_break = 1.0 # mm, inferred edge rounding\nzero = 0.0 # mm datum\nfull_turn = 360.0 # degrees\nquarter_turn = 90.0 # degrees\nhalf_turn = 180.0 # degrees\nr_flange = flange_diameter / 2\nr_tube = tube_diameter / 2\nr_bore = r_tube - tube_wall\nr_neck = neck_attachment_diameter / 2\nr_blend = blend_attachment_diameter / 2\nz_base_top = overall_length - bottom_flange_top_depth\nz_lower_tangent = overall_length - tube_lower_tangent_depth\nz_upper_tangent = overall_length - tube_upper_tangent_depth\nz_flange_bottom = overall_length - upper_flange_bottom_depth\nz_flange_top = overall_length - upper_flange_top_depth\nz_lobe_bottom = overall_length - lobed_thickness\nz_neck_tangent = z_lobe_bottom - neck_blend_radius\nz_recess_floor = overall_length - recess_depth\nassert z_recess_floor == recess_floor_to_base\nwith BuildPart() as core_builder:\n    with BuildSketch(Plane.XZ):\n        with BuildLine():\n            Polyline((r_bore,zero),(r_flange,zero),(r_flange,z_base_top),(r_blend,z_base_top))\n            CenterArc((r_blend,z_lower_tangent),large_blend_radius,-quarter_turn,-quarter_turn)\n            Line((r_tube,z_lower_tangent),(r_tube,z_upper_tangent))\n            CenterArc((r_blend,z_upper_tangent),large_blend_radius,half_turn,-quarter_turn)\n            Polyline((r_blend,z_flange_bottom),(r_flange,z_flange_bottom),(r_flange,z_flange_top),(r_blend,z_flange_top))\n            CenterArc((r_blend,z_neck_tangent),large_blend_radius,-quarter_turn,-quarter_turn)\n            CenterArc((r_neck,z_neck_tangent),neck_blend_radius,half_turn,-quarter_turn)\n            Polyline((r_neck,z_lobe_bottom),(r_neck,overall_length),(recess_diameter/2,overall_length),(recess_diameter/2,z_recess_floor),(r_bore,z_recess_floor),(r_bore,zero))\n        make_face()\n    revolve(axis=Axis.Z)\ncore = core_builder.part\n# Analytic tangent arcs: six convex R10 lobes and six concave R40 scallops.\ncenters = [(lobe_bolt_radius,zero),(lobe_ordinate_half,lobe_ordinate_diagonal),(-lobe_ordinate_half,lobe_ordinate_diagonal),(-lobe_bolt_radius,zero),(-lobe_ordinate_half,-lobe_ordinate_diagonal),(lobe_ordinate_half,-lobe_ordinate_diagonal)]\nscallop_centers = []\ntangent_out = []\ntangent_in = []\nfor i in range(lobe_count):\n    a = centers[i]\n    b = centers[(i+1)%lobe_count]\n    mx,my = (a[0]+b[0])/2,(a[1]+b[1])/2\n    dx,dy = b[0]-a[0],b[1]-a[1]\n    chord = math.hypot(dx,dy)\n    h = math.sqrt((lobe_radius+scallop_radius)**2-(chord/2)**2)\n    c = (mx+dy/chord*h,my-dx/chord*h)\n    scallop_centers.append(c)\n    tangent_out.append((a[0]+(c[0]-a[0])*lobe_radius/(lobe_radius+scallop_radius),a[1]+(c[1]-a[1])*lobe_radius/(lobe_radius+scallop_radius)))\n    tangent_in.append((b[0]+(c[0]-b[0])*lobe_radius/(lobe_radius+scallop_radius),b[1]+(c[1]-b[1])*lobe_radius/(lobe_radius+scallop_radius)))\nwith BuildPart() as lobe_builder:\n    with BuildSketch(Plane.XY.offset(z_lobe_bottom)):\n        with BuildLine():\n            for i in range(lobe_count):\n                a = centers[i]\n                theta = math.atan2(a[1],a[0])\n                mid = (a[0]+lobe_radius*math.cos(theta),a[1]+lobe_radius*math.sin(theta))\n                ThreePointArc(tangent_in[(i-1)%lobe_count],mid,tangent_out[i])\n                c = scallop_centers[i]\n                cr = math.hypot(*c)\n                midc = (c[0]*(1-scallop_radius/cr),c[1]*(1-scallop_radius/cr))\n                ThreePointArc(tangent_out[i],midc,tangent_in[i])\n        make_face()\n    extrude(amount=lobed_thickness)\nwith BuildPart() as final_builder:\n    add(core)\n    add(lobe_builder.part)\n    Cylinder(r_bore,overall_length,align=(Align.CENTER,Align.CENTER,Align.MIN),mode=Mode.SUBTRACT)\n    with Locations((zero,zero,z_recess_floor)):\n        Cylinder(recess_diameter/2,recess_depth,align=(Align.CENTER,Align.CENTER,Align.MIN),mode=Mode.SUBTRACT)\n    with Locations(*[(x,y,z_lobe_bottom) for x,y in centers]):\n        Cylinder(lobe_hole_diameter/2,lobed_thickness,align=(Align.CENTER,Align.CENTER,Align.MIN),mode=Mode.SUBTRACT)\n    with PolarLocations(flange_bolt_radius,flange_hole_count):\n        Cylinder(flange_hole_diameter/2,overall_length,align=(Align.CENTER,Align.CENTER,Align.MIN),mode=Mode.SUBTRACT)\nresult = final_builder.part\nshow(result,\"part\")\n"},"result":null,"error":null,"status":"in_progress"}}
