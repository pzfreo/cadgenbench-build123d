{"type":"item.started","item":{"id":"item_21","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"# Locate the wing datum using both printed envelope spans.\na = math.radians(channel_rotation)\nwing_x_shift = overall_width/2-(channel_end*math.cos(a)+channel_outer_width/2*math.sin(a))\nwing_y_shift = overall_depth-outer_radius-(channel_end*math.sin(a)+channel_outer_width/2*math.cos(a))\ndef wing_location(index):\n    return Pos(wing_x_shift if index==0 else -wing_x_shift,wing_y_shift,0)*Rot(Z=wing_angles[index])\nbody = Cylinder(outer_radius,overall_height,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    body=body.fuse(wing_location(i)*wing_box(channel_end,channel_outer_width,overall_height))\ncore=Pos(0,0,-boolean_margin)*Cylinder(bore_radius,overall_height+2*boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    core=core.fuse(wing_location(i)*wing_box(channel_end+boolean_margin,channel_inner_width,cavity_depth+boolean_margin,floor_thickness))\nbody=body.cut(core).cut(relief_builder.part)\nbase_body=body\n# Outer curved bends run along the channel rails.\nouter_bend_edges=[e for e in body.edges() if e.geom_type==GeomType.LINE and abs(e.center().Z)<1e-5 and e.length>wall_thickness and e.length<channel_end]\nprint(\"outer bend candidates\",[(tuple(e.center()),e.length) for e in outer_bend_edges])\nshow(body,\"housing\")\n"},"result":null,"error":null,"status":"in_progress"}}
