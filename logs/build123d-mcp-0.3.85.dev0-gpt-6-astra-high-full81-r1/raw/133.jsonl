{"type":"item.started","item":{"id":"item_44","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"# Analytic R5 shoulder arcs provide the full cast lug transition.\ndef shoulder_patch(radial):\n    enlarged_body=outer_radius+blend_radius\n    enlarged_lug=lug_radius+blend_radius\n    cx=(enlarged_body**2+radial**2-enlarged_lug**2)/(2*radial)\n    cy=math.sqrt(enlarged_body**2-cx**2)\n    def tangent_data(sign):\n        c=Vector(cx,sign*cy)\n        p_ring=c*(outer_radius/enlarged_body)\n        p_lug=Vector(radial,0)+(c-Vector(radial,0))*(lug_radius/enlarged_lug)\n        v1=(p_ring-c).normalized()\n        v2=(p_lug-c).normalized()\n        middle=c+(v1+v2).normalized()*blend_radius\n        return p_ring,p_lug,middle\n    prl,pll,pml=tangent_data(-1)\n    pru,plu,pmu=tangent_data(1)\n    with BuildSketch() as patch:\n        with BuildLine():\n            ThreePointArc(prl,pml,pll)\n            ThreePointArc(pll,(radial+lug_radius,0),plu)\n            ThreePointArc(plu,pmu,pru)\n            Polyline(pru,(outer_radius-blend_radius,pru.Y),(outer_radius-blend_radius,prl.Y),prl)\n        make_face()\n    return patch.sketch\nbody=Cylinder(outer_radius,overall_height,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    body=body.fuse(wing_location(i)*wing_outer)\nbody=body.cut(core).cut(relief_builder.part)\nfor x,y in lug_points:\n    radial=math.hypot(x,y)\n    phi=math.degrees(math.atan2(y,x))\n    patch=shoulder_patch(radial)\n    ear=Pos(0,0,overall_height-lug_thickness)*Rot(Z=phi)*extrude(patch,amount=lug_thickness)\n    body=body.fuse(ear)\nfor x,y in lug_points:\n    body=body.cut(Pos(x,y,overall_height-lug_thickness-boolean_margin)*Cylinder(lug_hole_diameter/2,lug_thickness+2*boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN)))\nfor i in range(len(wing_angles)):\n    for sign in (-1,1):\n        for t,z in [(sign*(channel_outer_width/2-thread_edge_offset),overall_height-thread_edge_offset),(sign*(channel_inner_width/2-thread_edge_offset),thread_edge_offset)]:\n            drill=Pos(channel_end-thread_depth,t,z)*Rot(Y=90)*Cylinder(thread_diameter/2,thread_depth+boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN))\n            body=body.cut(wing_location(i)*drill)\n    groove=Pos(groove_station,0,floor_thickness)*Rot(X=90)*Cylinder(groove_radius,channel_inner_width)\n    for sign in (-1,1):\n        groove=groove.fuse(Pos(groove_station,sign*channel_inner_width/2,floor_thickness)*Sphere(groove_radius))\n    body=body.cut(wing_location(i)*groove)\nshow(body,\"housing\")\n"},"result":null,"error":null,"status":"in_progress"}}
