{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' model_history.py\"","aggregated_output":"from build123d import *\nimport math\noverall_width = 181.47 # mm reference\noverall_depth = 108.96 # mm reference\noverall_height = 40.0 # mm overall top to bottom\nouter_diameter = 100.0 # mm\nbore_diameter = 76.0 # mm\nchannel_outer_width = 85.41 # mm\nchannel_inner_width = 61.41 # mm\nchannel_end = 81.43 # mm radial\ngroove_station = 62.43 # mm radial\nchannel_axis_angle = 74.63 # degrees from Y\nwall_thickness = 12.0 # mm\nfloor_thickness = 12.0 # mm\ncavity_depth = 28.0 # mm from top to floor\nlip_underside_from_top = 30.0 # mm\nlip_thickness = 2.0 # mm\ngroove_width = 8.0 # mm\ngroove_depth = 4.0 # mm\ngroove_radius = 4.0 # mm\nlug_radius = 5.5 # mm\nblend_radius = 5.0 # mm\nedge_radius = 0.5 # mm\nlug_hole_diameter = 5.0 # mm\nlug_hole_count = 4\nupper_lug_angle = 20.91 # degrees from Y\nlower_lug_angle = 38.29 # degrees from -Y\nupper_lug_y = 52.34 # mm center to upper row\nlower_lug_y = 44.33 # mm center to lower row\nlug_row_span = 96.67 # mm\nthread_diameter = 6.0 # mm nominal M6\nthread_depth = 10.0 # mm\nthread_count = 8\nthread_edge_offset = 6.0 # mm\nboolean_margin = 1.0 # mm construction allowance\nouter_radius = outer_diameter/2\nbore_radius = bore_diameter/2\nlip_bottom = overall_height-lip_underside_from_top\nchannel_rotation = 90-channel_axis_angle\nlug_points = [(s*upper_lug_y*math.tan(math.radians(upper_lug_angle)),upper_lug_y) for s in (-1,1)] + [(s*lower_lug_y*math.tan(math.radians(lower_lug_angle)),-lower_lug_y) for s in (-1,1)]\nwing_angles = [channel_rotation,180-channel_rotation]\ndef wing_box(length,width,height,z=0):\n    return Pos(0,0,z)*Box(length,width,height,align=(Align.MIN,Align.CENTER,Align.MIN))\nbody = Cylinder(outer_radius,overall_height,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor angle in wing_angles:\n    body = body.fuse(Rot(Z=angle)*wing_box(channel_end,channel_outer_width,overall_height))\n# Primary core: bore plus open-ended channels\ncore = Pos(0,0,-boolean_margin)*Cylinder(bore_radius,overall_height+2*boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor angle in wing_angles:\n    core = core.fuse(Rot(Z=angle)*wing_box(channel_end+boolean_margin,channel_inner_width,cavity_depth+boolean_margin,floor_thickness))\nbody = body.cut(core)\n# Underside annular relief, curved between the bore lip and OD\nwith BuildPart() as relief_builder:\n    with BuildSketch(Plane.XZ):\n        with BuildLine():\n            Polyline((0,-boolean_margin),(outer_radius,-boolean_margin),(outer_radius,0))\n            ThreePointArc((outer_radius,0),((outer_radius+bore_radius)/2,lip_bottom*0.30),(bore_radius,lip_bottom))\n            Polyline((bore_radius,lip_bottom),(0,lip_bottom),(0,-boolean_margin))\n        make_face()\n    revolve(axis=Axis.Z)\nbody = body.cut(relief_builder.part)\nshow(body,\"housing\")\n\n\n# Locate the wing datum using both printed envelope spans.\na = math.radians(channel_rotation)\nwing_x_shift = overall_width/2-(channel_end*math.cos(a)+channel_outer_width/2*math.sin(a))\nwing_y_shift = overall_depth-outer_radius-(channel_end*math.sin(a)+channel_outer_width/2*math.cos(a))\ndef wing_location(index):\n    return Pos(wing_x_shift if index==0 else -wing_x_shift,wing_y_shift,0)*Rot(Z=wing_angles[index])\nbody = Cylinder(outer_radius,overall_height,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    body=body.fuse(wing_location(i)*wing_box(channel_end,channel_outer_width,overall_height))\ncore=Pos(0,0,-boolean_margin)*Cylinder(bore_radius,overall_height+2*boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    core=core.fuse(wing_location(i)*wing_box(channel_end+boolean_margin,channel_inner_width,cavity_depth+boolean_margin,floor_thickness))\nbody=body.cut(core).cut(relief_builder.part)\nbase_body=body\n# Outer curved bends run along the channel rails.\nouter_bend_edges=[e for e in body.edges() if e.geom_type==GeomType.LINE and abs(e.center().Z)<1e-5 and e.length>wall_thickness and e.length<channel_end]\nprint(\"outer bend candidates\",[(tuple(e.center()),e.length) for e in outer_bend_edges])\nshow(body,\"housing\")\n\n\n# Inner floor-to-wall bends; outer bend radius follows the 12 mm section.\ntry:\n    body=fillet(outer_bend_edges,wall_thickness)\n    print(\"outer bends applied\")\nexcept Exception as err:\n    print(\"outer bend\",str(err)[:180])\ninner_bend_edges=[e for e in body.edges() if abs(e.center().Z-floor_thickness)<1e-5 and e.geom_type==GeomType.LINE and e.length>wall_thickness and e.length<channel_end]\ntry:\n    body=fillet(inner_bend_edges,blend_radius)\n    print(\"inner bends applied\",len(inner_bend_edges))\nexcept Exception as err:\n    print(\"inner bend\",str(err)[:180])\nshow(body,\"housing\")\n\n\n# Construct the bends in each simple channel before joining the annulus.\nwing_outer=wing_box(channel_end,channel_outer_width,overall_height)\nedges_outer=[e for e in wing_outer.edges().filter_by(Axis.X) if abs(e.center().Z)<1e-5]\nwing_outer=fillet(edges_outer,wall_thickness)\nwing_core=wing_box(channel_end+boolean_margin,channel_inner_width,cavity_depth+boolean_margin,floor_thickness)\nedges_inner=[e for e in wing_core.edges().filter_by(Axis.X) if abs(e.center().Z-floor_thickness)<1e-5]\nwing_core=fillet(edges_inner,blend_radius)\nbody=Cylinder(outer_radius,overall_height,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    body=body.fuse(wing_location(i)*wing_outer)\ncore=Pos(0,0,-boolean_margin)*Cylinder(bore_radius,overall_height+2*boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    core=core.fuse(wing_location(i)*wing_core)\nbody=body.cut(core).cut(relief_builder.part)\n# Four short rim lugs, with radial necks buried in the annular side wall.\nlug_thickness=thread_edge_offset # mm rim projection visible in front view\nfor x,y in lug_points:\n    radial=math.hypot(x,y)\n    phi=math.degrees(math.atan2(y,x))\n    neck_start=outer_radius-blend_radius\n    neck=Pos(neck_start,0,overall_height-lug_thickness)*Box(radial-neck_start,lug_radius*2,lug_thickness,align=(Align.MIN,Align.CENTER,Align.MIN))\n    ear=Pos(x,y,overall_height-lug_thickness)*Cylinder(lug_radius,lug_thickness,align=(Align.CENTER,Align.CENTER,Align.MIN))\n    body=body.fuse(Rot(Z=phi)*neck,ear)\n# Drill the lug holes and blind horizontal M6 end holes.\nfor x,y in lug_points:\n    body=body.cut(Pos(x,y,overall_height-lug_thickness-boolean_margin)*Cylinder(lug_hole_diameter/2,lug_thickness+2*boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN)))\nfor i in range(len(wing_angles)):\n    for sign in (-1,1):\n        for t,z in [(sign*(channel_outer_width/2-thread_edge_offset),overall_height-thread_edge_offset),(sign*(channel_inner_width/2-thread_edge_offset),thread_edge_offset)]:\n            drill=Pos(channel_end-thread_depth,t,z)*Rot(Y=90)*Cylinder(thread_diameter/2,thread_depth+boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN))\n            body=body.cut(wing_location(i)*drill)\n# Semicircular blind floor grooves with hemispherical ends.\nfor i in range(len(wing_angles)):\n    groove=Pos(groove_station,0,floor_thickness)*Rot(X=90)*Cylinder(groove_radius,channel_inner_width)\n    for sign in (-1,1):\n        groove=groove.fuse(Pos(groove_station,sign*channel_inner_width/2,floor_thickness)*Sphere(groove_radius))\n    body=body.cut(wing_location(i)*groove)\nshow(body,\"housing\")\n\n\nprint(\"vertical\",[(tuple(e.center()),round(e.length,4)) for e in body.edges().filter_by(Axis.Z)])\n\n\nlug_root_edges=[e for e in body.edges().filter_by(Axis.Z) if abs(e.length-lug_thickness)<1e-5 and math.hypot(e.center().X,e.center().Y)<outer_radius+blend_radius and all(abs(math.hypot(e.center().X-x,e.center().Y-y)-lug_hole_diameter/2)>1e-4 for x,y in lug_points)]\nprint(\"lug root edge count\",len(lug_root_edges))\ntry:\n    rounded=fillet(lug_root_edges,blend_radius)\n    body=rounded\n    print(\"lug roots rounded\")\nexcept Exception as err:\n    print(str(err)[:250])\nshow(body,\"housing\")\n\n\ntop_faces=[f for f in body.faces() if f.geom_type==GeomType.PLANE and abs(f.center().Z-overall_height)<1e-5]\ntop_face=max(top_faces,key=lambda f:f.area)\nroot_centers=[e.center() for e in lug_root_edges]\nroot_vertices=[v for v in top_face.vertices() if any(math.hypot(v.X-c.X,v.Y-c.Y)<1e-5 for c in root_centers)]\nprint(\"top roots\",len(root_vertices), \"top faces\",len(top_faces))\ntry:\n    rounded_top=fillet(root_vertices,blend_radius)\n    print(\"rounded top\",type(rounded_top),rounded_top.area)\nexcept Exception as err:\n    print(str(err)[:250])\n\n\nimport inspect\nprint(inspect.signature(Face.fillet_2d))\nprint(inspect.signature(Wire.fillet_2d))\nshow(body,\"housing\")\n\n\nbefore_rounding=body\nfor face in top_faces:\n    vertices=[v for v in face.vertices() if any(math.hypot(v.X-c.X,v.Y-c.Y)<1e-5 for c in root_centers)]\n    try:\n        rounded_face=face.fillet_2d(blend_radius,vertices)\n        top_band=extrude(rounded_face,amount=-lug_thickness)\n        body=body.fuse(top_band)\n        print(\"blended top band\",len(vertices))\n    except Exception as err:\n        print(\"2d lug blend\",str(err)[:200])\nshow(body,\"housing\")\n\n\n# Analytic R5 shoulder arcs provide the full cast lug transition.\ndef shoulder_patch(radial):\n    enlarged_body=outer_radius+blend_radius\n    enlarged_lug=lug_radius+blend_radius\n    cx=(enlarged_body**2+radial**2-enlarged_lug**2)/(2*radial)\n    cy=math.sqrt(enlarged_body**2-cx**2)\n    def tangent_data(sign):\n        c=Vector(cx,sign*cy)\n        p_ring=c*(outer_radius/enlarged_body)\n        p_lug=Vector(radial,0)+(c-Vector(radial,0))*(lug_radius/enlarged_lug)\n        v1=(p_ring-c).normalized()\n        v2=(p_lug-c).normalized()\n        middle=c+(v1+v2).normalized()*blend_radius\n        return p_ring,p_lug,middle\n    prl,pll,pml=tangent_data(-1)\n    pru,plu,pmu=tangent_data(1)\n    with BuildSketch() as patch:\n        with BuildLine():\n            ThreePointArc(prl,pml,pll)\n            ThreePointArc(pll,(radial+lug_radius,0),plu)\n            ThreePointArc(plu,pmu,pru)\n            Polyline(pru,(outer_radius-blend_radius,pru.Y),(outer_radius-blend_radius,prl.Y),prl)\n        make_face()\n    return patch.sketch\nbody=Cylinder(outer_radius,overall_height,align=(Align.CENTER,Align.CENTER,Align.MIN))\nfor i in range(len(wing_angles)):\n    body=body.fuse(wing_location(i)*wing_outer)\nbody=body.cut(core).cut(relief_builder.part)\nfor x,y in lug_points:\n    radial=math.hypot(x,y)\n    phi=math.degrees(math.atan2(y,x))\n    patch=shoulder_patch(radial)\n    ear=Pos(0,0,overall_height-lug_thickness)*Rot(Z=phi)*extrude(patch,amount=lug_thickness)\n    body=body.fuse(ear)\nfor x,y in lug_points:\n    body=body.cut(Pos(x,y,overall_height-lug_thickness-boolean_margin)*Cylinder(lug_hole_diameter/2,lug_thickness+2*boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN)))\nfor i in range(len(wing_angles)):\n    for sign in (-1,1):\n        for t,z in [(sign*(channel_outer_width/2-thread_edge_offset),overall_height-thread_edge_offset),(sign*(channel_inner_width/2-thread_edge_offset),thread_edge_offset)]:\n            drill=Pos(channel_end-thread_depth,t,z)*Rot(Y=90)*Cylinder(thread_diameter/2,thread_depth+boolean_margin,align=(Align.CENTER,Align.CENTER,Align.MIN))\n            body=body.cut(wing_location(i)*drill)\n    groove=Pos(groove_station,0,floor_thickness)*Rot(X=90)*Cylinder(groove_radius,channel_inner_width)\n    for sign in (-1,1):\n        groove=groove.fuse(Pos(groove_station,sign*channel_inner_width/2,floor_thickness)*Sphere(groove_radius))\n    body=body.cut(wing_location(i)*groove)\nshow(body,\"housing\")\n\n\npre_edge_rounds=body\ntop_edges=[]\nfor e in body.edges():\n    bb=e.bounding_box()\n    if abs(bb.min.Z-overall_height)<1e-5 and abs(bb.max.Z-overall_height)<1e-5:\n        is_hole_rim=e.geom_type==GeomType.CIRCLE and abs(e.radius-lug_hole_diameter/2)<1e-5\n        if not is_hole_rim:\n            top_edges.append(e)\nprint(\"top rim edges\",len(top_edges))\ntry:\n    body=fillet(top_edges,edge_radius)\n    print(\"R0.5 top edge rounds applied\")\nexcept Exception as err:\n    print(\"edge rounding\",str(err)[:200])\nshow(body,\"housing\")\n\n\nend_top_edges=[e for e in body.edges() if e.geom_type==GeomType.LINE and abs(e.center().Z-overall_height)<1e-5 and abs(e.length-wall_thickness)<1e-5]\nprint(\"end top edges\",len(end_top_edges))\nbody=fillet(end_top_edges,edge_radius)\nshow(body,\"housing\")\n","exit_code":0,"status":"completed"}}
