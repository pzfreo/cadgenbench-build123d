result=result-Pos(zero,zero,small_port_axis_z)*Rot(Y=right_angle)*cyl(small_port_thread_dia/2,port_x_end,zero)\n    88\tshow(result,'housing')\n    89\t\n    90\tprint([n for n in globals() if n in ['current_shape','housing','objects','get_object']])\n    91\tprint(type(current_shape).__name__ if 'current_shape' in globals() else 'no current_shape')\n    92\t\n    93\tresult=import_step('/var/folders/nc/sgtnd9hs0yjfrp26bcq3rwnr0000gn/T/cgb_fixture.C2WXKa/output.step')\n    94\t# Replace the lower web only; keep 1 mm overlap with its surrounding ring.\n    95\tweb_replacement_r=bore_r-boolean_overlap\n    96\tresult=result-cyl(web_replacement_r,web_thickness+2*boolean_overlap,-boolean_overlap)\n    97\tnew_web=cyl(bore_r,web_thickness)-cyl(central_bore_dia/2,web_thickness)\n    98\tfor k in range(window_count):\n    99\t new_web=new_web-Rot(Z=right_angle+k*window_pitch)*corrected_window\n   100\tfor k in range(window_count):\n   101\t for r in [web_inner_hole_r,web_hole_pcd/2]:\n   102\t  x,y=polar(r,right_angle+k*window_pitch)\n   103\t  new_web=new_web-cyl(web_small_hole_dia/2,web_thickness,zero,x,y)\n   104\tresult=result.fuse(new_web)\n   105\tfor k in range(base_hole_count):\n   106\t x,y=polar(base_pcd/2,base_start_angle+k*full_turn/base_hole_count)\n   107\t result=result-cyl(mount_dia/2,pad_top_z+boolean_overlap,-boolean_overlap,x,y)\n   108\tshow(result,'housing')\n   109\t\n   110\t# Fill only the uncalled-for rib cavity, with deliberate radial/axial overlap.\n   111\trib_plug_r=conduit_dia/2-conduit_wall+boolean_overlap\n   112\trib_plug=cyl(rib_plug_r,small_port_axis_z-base_thickness+boolean_overlap,base_thickness-boolean_overlap,conduit_center_x)\n   113\tresult=result.fuse(rib_plug)\n   114\tresult=result-Pos(zero,zero,small_port_axis_z)*Rot(Y=right_angle)*cyl(small_port_thread_dia/2,port_x_end,zero)\n   115\tshow(result,'housing')\n   116\t\n   117\tprint([(i,tuple(round(v,2) for v in e.center()),round(e.length,2)) for i,e in enumerate(result.edges()) 