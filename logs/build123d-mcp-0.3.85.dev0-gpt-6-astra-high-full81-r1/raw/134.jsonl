illet(handle.edges().filter_by(Axis.Z),radius=boss_corner_r)\nopening=fillet(opening.edges().filter_by(Axis.Z),radius=boss_corner_r)\nresult=result.fuse(handle-opening)\nlarge_port_length=port_y_end-body_r+boolean_overlap\nlarge_port=Pos(zero,zero,rim_bottom)*Rot(X=right_angle)*Pos(zero,zero,body_r-boolean_overlap)*extrude(RectangleRounded(boss_width,boss_width,boss_corner_r),amount=large_port_length)\nresult=result.fuse(large_port)\nsmall_port_length=port_x_end-body_r+boolean_overlap\nsmall_port=Pos(zero,zero,small_port_axis_z)*Rot(Y=right_angle)*cyl(small_port_od/2,small_port_length,body_r-boolean_overlap)\nconduit_center_x=body_r+conduit_dia/2-conduit_wall\nconduit=cyl(conduit_dia/2,small_port_axis_z-base_thickness,base_thickness,conduit_center_x)\nresult=result.fuse(small_port,conduit)\nresult=result-Pos(zero,zero,rim_bottom)*Rot(X=right_angle)*cyl(port_bore_dia/2,port_y_end,zero)\nresult=result-Pos(zero,zero,small_port_axis_z)*Rot(Y=right_angle)*cyl(small_port_thread_dia/2,port_x_end,zero)\nresult=result-cyl(conduit_dia/2-conduit_wall,small_port_axis_z-base_thickness,base_thickness,conduit_center_x)\nfor k in range(base_hole_count):\n x,y=polar(base_pcd/2,base_start_angle+k*full_turn/base_hole_count)\n result=result-cyl(mount_dia/2,pad_top_z,zero,x,y)\nfor a in upper_angles:\n x,y=polar(top_pcd/2,a)\n result=result-cyl(mount_dia/2,rim_thickness,rim_bottom,x,y)\nfor k in range(window_count):\n for r in [web_inner_hole_r,web_hole_pcd/2]:\n  x,y=polar(r,right_angle+k*window_pitch)\n  result=result-cyl(web_small_hole_dia/2,web_thickness,zero,x,y)\nshow(result,'housing')"},"result":{"content":[{"type":"text","text":"Registered 'housing': volume=1.068e+06 mm³, faces=140\n--- current_shape (\"housing\") ---\nvolume: 1.068e+06 mm³  |  bbox: 225×268×338 mm  |  140f 414e 266v\n# vars: a=-112.7, conduit_center_x=86.0, k=2, large_port_length=53.0, r=67.0, small_port_length=43.0, x=58.02370205355737, y=-33.50000000000003\n\nSession objects: housing (Solid, 140 faces)"}],"st