 deg\nright_angle = 90.0 # deg\nhalf_turn = 180.0 # deg\nwindow_pitch = full_turn/window_count\nrim_thickness = height-rim_bottom\nbody_span = rim_bottom-base_thickness\nbase_pad_height = pad_top_z-base_thickness\nbody_r = body_od/2\nbore_r = body_id/2\nbase_r = base_od/2\nupper_angles = [mount_angle_high,half_turn-mount_angle_high,mount_angle_low,half_turn-mount_angle_low,-right_angle+mount_angle_bottom,-right_angle-mount_angle_bottom]\ndef polar(r,a):\n return (r*math.cos(math.radians(a)),r*math.sin(math.radians(a)))\ndef cyl(r,h,z=zero,x=zero,y=zero):\n return Pos(x,y,z)*Cylinder(r,h,align=(Align.CENTER,Align.CENTER,Align.MIN))\ndef sector(ri,ro,start,sweep,thick,z):\n with BuildSketch() as sk:\n  with BuildLine():\n   outer=CenterArc((zero,zero),ro,start,sweep)\n   Line(outer@1,polar(ri,start+sweep))\n   inner=CenterArc((zero,zero),ri,start+sweep,-sweep)\n   Line(inner@1,outer@0)\n  make_face()\n return Pos(z=z)*extrude(sk.sketch,amount=thick)\n# Side profile first: annular base, 3 mm shell, thick upper rim.\nresult = cyl(base_r,base_thickness) - cyl(bore_r,base_thickness)\nresult = result.fuse(cyl(body_r,rim_bottom,zero)-cyl(bore_r,rim_bottom,zero))\nresult = result.fuse(cyl(rim_outer_r,rim_thickness+boolean_overlap,rim_bottom-boolean_overlap)-cyl(bore_r,rim_thickness+boolean_overlap,rim_bottom-boolean_overlap))\n# Lower spoked diaphragm: disk with three genuinely open, radiused windows.\nweb=cyl(bore_r+boolean_overlap,web_thickness)\n# Window boundaries: concentric R35/R72, radial sides offset by spoke width.\nwindow_start=math.degrees(math.asin(web_spoke_half_width/window_inner_r))\nwindow_end=window_pitch-window_start\nwindow_cut=sector(window_inner_r,window_outer_r,window_start,window_end-window_start,web_thickness,zero)\ntry:\n window_cut=fillet(window_cut.edges().filter_by(Axis.Z),radius=window_corner_r)\nexcept Exception as err:\n print('window corner:',err)\nfor k in range(window_count):\n web=web-Rot(Z=right_angle+k*window_pitch)*window_cut\nweb=web-cyl(central_bore_dia/2,web_thickness)\nresult=result.fuse(web)\n# Four lower mounting pads, and six lobes on the upper flange.\nfor k in range(base_hole_count):\n a=base_start_angle+k*full_turn/base_hole_count\n x,y=polar(base_pcd/2,a)\n pad=Pos(x,y,zero)*Cylinder(lug_fillet_r,pad_top_z,align=(Align.CENTER,Align.CENTER,Align.MIN))\n connector=Rot(Z=a)*Pos(body_r,zero,base_thickness)*Box(base_pcd/2-body_r,lug_width,base_pad_height,align=(Align.MIN,Align.CENTER,Align.MIN))\n result=result.fuse(pad,connector)\nfor a in upper_angles:\n x,y=polar(top_pcd/2,a)\n result=result.fuse(cyl(top_lug_r,rim_thickness,rim_bottom,x,y))\n# Curved handle, with large open grip region.\nhandle=sector(bore_r,handle_outer_r,right_angle-handle_half_angle,handle_half_angle*2,rim_thickness,rim_bottom)\nopening=sector(handle_open_inner_r,handle_inner_r,right_angle-handle_half_angle+boss_corner_r,2*(handle_half_angle-boss_corner_r),rim_thickness,rim_bottom)\ntry:\n handle=fillet(handle.edges().filter_by(Axis.Z),radius=boss_corner_r)\n opening=fillet(opening.edges().filter_by(Axis.Z),radius=boss_corner_r)\nexcept Exception as err:\n print('handle corner:',err)\nresult=result.fuse(handle-opening)\n# Square radial port points toward -Y; its bore is at z308.\nlarge_port_length=port_y_end-body_r+boolean_overlap\nlarge_port=Pos(z=rim_bottom)*Rot(X=right_angle)*Pos(z=body_r-boolean_overlap)*extrude(RectangleRounded(boss_width,boss_width,boss_corner_r),amount=large_port_length)\nresult=result.fuse(large_port)\n# Small radial nozzle points +X and has an integral vertical tube below.\nsmall_port_length=port_x_end-body_r+boolean_overlap\nsmall_port=Pos(z=small_port_axis_z)*Rot(Y=right_angle)*cyl(small_port_od/2,small_port_length,body_r-boolean_overlap)\nconduit_center_x=body_r+conduit_dia/2-conduit_wall\nconduit=cyl(conduit_dia/2,small_port_axis_z-base_thickness,base_thickness,conduit_center_x)\nresult=result.fuse(small_port,conduit)\n# Drill only after shell/profile construction.\nresult=result-Pos(z=rim_bottom)*Rot(X=right_angle)*cyl(port_bore_dia/2,port_y_end,zero)\nresult=result-Pos(z=small_port_axis_z)*Rot(Y=right_angle)*cyl(small_port_thread_dia/2,port_x_end,zero)\nresult=result-cyl(conduit_dia/2-conduit_wall,small_port_axis_z-base_thickness,base_thickness,conduit_center_x)\nfor k in range(base_hole_count):\n x,y=polar(base_pcd/2,base_start_angle+k*full_turn/base_hole_count)\n result=result-cyl(mount_dia/2,pad_top_z,zero,x,y)\nfor a in upper_angles:\n x,y=polar(top_pcd/2,a)\n result=result-cyl(mount_dia/2,rim_thickness,rim_bottom,x,y)\nfor k in range(window_count):\n for r in [web_inner_hole_r,web_hole_pcd/2]:\n  x,y=polar(r,right_angle+k*window_pitch)\n  result=result-cyl(web_small_hole_dia/2,web_thickness,zero,x,y)\nshow(result,'housing')\n"},"result":null,"error":null,"status":"in_progress"}}
