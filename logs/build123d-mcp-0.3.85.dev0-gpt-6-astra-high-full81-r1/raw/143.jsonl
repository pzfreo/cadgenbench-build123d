_small = 12.48 # mm\nd_left_lug = 23.35 # mm\nd_lower = 22.78 # mm\nd_valley_a = 5.36 # mm\nd_valley_b = 11.57 # mm\nd_right_pair = 4.00 # mm\nd_right_lug = 29.01 # mm\nd_right_middle = 21.06 # mm\nd_tip = 26.47 # mm\nd_side = 8.00 # mm\nside_station = 130.87 # mm\nd_side_b = 7.00 # mm\nb_pitch = 50.00 # mm\nb_z = 39.78 # mm\nd_side_small = 5.00 # mm\na_pitch = 20.00 # mm\na_z = 29.00 # mm\na_station = 35.29 # mm\nd_z = 34.11 # mm\nd_station = 10.39 # mm\nd_first_pitch = 40.00 # mm\nd_pitch = 20.00 # mm\nd_blind_depth = 8.00 # mm\nf_z = 23.83 # mm\nf_pitch = 10.00 # mm\nf_gap = 20.00 # mm\nf_station = 6.84 # mm\ne_z = 32.83 # mm\ne_small_z = 33.35 # mm\ne_station = 9.63 # mm\ne_pitch = 13.00 # mm\ne_blind_one = 9.00 # mm\ne_blind_two = 10.00 # mm\ne_bore_d = 22.41 # mm\ne_end = 16.23 # mm\nwall = 7.81 # mm, left perimeter web callout\nrib = 9.61 # mm\nj_width = 40.23 # mm\nj_height = 72.79 # mm\nj_bottom_radius = 5.00 # mm\nh_width = 29.79 # mm\nh_height = 62.13 # mm\nh_radius = 10.00 # mm\nk_width = 36.91 # mm\nk_height = 32.80 # mm\nk_lower_height = 24.96 # mm\nk_radius = 4.00 # mm\nl_length = 103.66 # mm\nl_height = 60.28 # mm\nl_bore_radius = 22.58 # mm\ni_rib_angle = 11.0 # degrees, undimensioned local rib inclination\nsmall_fillet = 2.00 # mm\n# Inferred plan datums constrained by the printed chains; no pixel scaling.\nleft_lug_x = -left_transition_span-left_lug_radius/2\nleft_lug_y = -upper_left_bore_drop\nlower_bore_x = land_span-land_to_bore\nright_lug_x = land_span+right_transition_radius+upper_notch_radius\nright_lug_y = -right_lug_drop\nright_dir = Vector(math.cos(math.radians(right_angle)),math.sin(math.radians(right_angle)),0)\nright_normal = Vector(-right_dir.Y,right_dir.X,0)\ntip_center = Vector(right_lug_x,right_lug_y,0)+right_lower_span*right_dir\nleft_shoulder = Vector(left_lug_x,left_lug_y,0)+left_slope_length*Vector(math.cos(math.radians(left_angle)),math.sin(math.radians(left_angle)),0)\nupper_start = left_shoulder+Vector(upper_left_span,-upper_notch_radius,0)\nupper_dir = Vector(math.cos(math.radians(right_angle-10)), -math.sin(math.radians(right_angle-10)),0)\nupper_norm = Vector(upper_dir.Y,-upper_dir.X,0)\nupper_end = upper_start+upper_slope_length*upper_dir\nvalley_end = upper_end+Vector(valley_span,-upper_notch_radius,0)\n# Exterior follows connected cast rails; datum intersections are rounded analytically.\nouter_points = [\n(left_shoulder.X-corner_radius,left_shoulder.Y+corner_radius),\n(upper_start.X,upper_start.Y+corner_radius),\n(upper_end.X,upper_end.Y),\n(valley_end.X,valley_end.Y),\n(tip_center.X-tip_land,tip_center.Y+tip_radius),\n(tip_center.X+tip_radius/2,tip_center.Y+tip_radius/2),\n(tip_center.X+tip_radius,tip_center.Y-tip_radius/2),\n(right_lug_x,right_lug_y-right_lug_radius),\n(land_span,0),\n(0,0),\n(left_lug_x,left_lug_y-left_lug_radius)]\n# Polygon fillets construct continuous circular silhouette, not faceted tracing.\ndef rounded_face(points, radius):\n    face = Face(Wire.make_polygon([Vector(x,y,0) for x,y in points],close=True))\n    return face.fillet_2d(radius,face.vertices())\nouter_face = rounded_face(outer_points,corner_radius/2)\nbody = extrude(outer_face,amount=overall_thickness)\n# Primary cored pockets. Bottom web remains continuous at 14 mm.\npx0 = left_shoulder.X+wall\npx1 = upper_start.X-rib\npocket_points = [\n[(px0,left_shoulder.Y),(left_lug_x+wall,left_lug_y+wall),(px1-rib,upper_start.Y)],\n[(px1,upper_start.Y),(upper_end.X-rib,upper_end.Y-rib),(lower_bore_x+rib,bore_lower_y),(left_lug_x+left_lug_radius+rib,left_lug_y+wall)],\n[(lower_bore_x+rib,bore_lower_y),(upper_end.X-rib,upper_end.Y-rib),(upper_end.X+h_width,upper_end.Y-rib),(upper_end.X+h_width,wall)],\n[(upper_end.X+h_width+rib,wall),(upper_end.X+h_width+rib,upper_end.Y-rib),(valley_end.X-rib,valley_end.Y-rib),(valley_end.X-rib,wall)],\n[(valley_end.X,wall),(valley_end.X,valley_end.Y-rib),(right_lug_x+rib,valley_end.Y+k_height),(right_lug_x+rib,wall)],\n[(right_lug_x+rib*2,valley_end.Y+k_height),(tip_center.X-tip_land-rib,tip_center.Y+tip_radius-wall),(tip_center.X-tip_land+k_width/2,tip_center.Y+wall),(right_lug_x+rib*2,valley_end.Y)],\n[(right_lug_x+right_lug_radius,right_lug_y+rib),(tip_center.X+wall,tip_center.Y-tip_radius/2+wall),(tip_center.X+wall,tip_center.Y+wall),(right_lug_x+right_lug_radius,valley_end.Y-rib)]\n]\n# Exact bore sizes; connecting local datums use dimensioned stations.\nholes = []\nholes.append((left_shoulder.X+upper_left_bore_offset,left_shoulder.Y,d_left_pair))\nholes.append((upper_start.X-upper_left_bore_offset/2,upper_start.Y,d_left_pair))\nfor station,normal,dia in [(upper_bore_station,upper_bore_normal,d_upper),(upper_small_station,upper_small_normal,d_upper_small)]:\n    v=upper_start+station*upper_dir+normal*upper_norm\n    holes.append((v.X,v.Y,dia))\nholes.extend([(left_lug_x,left_lug_y,d_left_lug),(lower_bore_x,bore_lower_y,d_lower)])\nholes.extend([(upper_end.X+valley_bore_a,upper_end.Y-valley_drop_a,d_valley_a),(upper_end.X+valley_bore_b,upper_end.Y-valley_drop_b,d_valley_b)])\nholes.extend([(valley_end.X+right_small_normal_a,valley_end.Y-valley_drop_b,d_right_pair),(valley_end.X+right_small_normal_b+valley_drop_a,valley_end.Y-valley_drop_b,d_right_pair)])\nholes.append((right_lug_x,right_lug_y,d_right_lug))\nmid=Vector(right_lug_x,right_lug_y,0)+right_bore_station*right_dir+right_bore_normal*right_normal\nholes.extend([(mid.X,mid.Y,d_right_middle),(tip_center.X,tip_center.Y,d_tip)])\n# Subtract each blind cavity while keeping bore sleeves continuous.\nfor pts in pocket_points:\n    pf=rounded_face(pts,small_fillet)\n    cutter=extrude(pf,amount=pocket_depth).translate((0,0,floor_thickness))\n    for hx,hy,hd in holes:\n        sleeve=Cylinder(hd/2+wall/2,overall_thickness,align=(Align.CENTER,Align.CENTER,Align.MIN)).translate((hx,hy,0))\n        cutter=cutter-sleeve\n    body=body-cutter\nfor hx,hy,hd in holes:\n    body=body-Cylinder(hd/2,overall_thickness,align=(Align.CENTER,Align.CENTER,Align.MIN)).translate((hx,hy,0))\nresult