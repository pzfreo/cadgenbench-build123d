{"type":"item.started","item":{"id":"item_31","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"# Broaden the seven cored regions and tie the sleeves into their partition ribs.\npocket_points[1]=[(px1,upper_start.Y+corner_radius),(left_lug_x+left_lug_radius+rib,left_lug_y-corner_radius),(lower_bore_x+rib,left_lug_y-corner_radius),(lower_bore_x+rib,upper_start.Y+corner_radius)]\npocket_points[2]=[(lower_bore_x+rib*2,left_lug_y-corner_radius),(lower_bore_x+rib*2,upper_end.Y+corner_radius),(upper_end.X+h_width,upper_end.Y+corner_radius),(upper_end.X+h_width,left_lug_y-corner_radius)]\npocket_points[3]=[(upper_end.X+h_width+rib,left_lug_y-corner_radius),(upper_end.X+h_width+rib,upper_end.Y+corner_radius),(valley_end.X-rib,upper_end.Y+corner_radius),(valley_end.X-rib,left_lug_y-corner_radius)]\npocket_points[4]=[(valley_end.X,left_lug_y-corner_radius),(valley_end.X,valley_end.Y+corner_radius),(right_lug_x+rib,valley_end.Y+corner_radius),(right_lug_x+rib,left_lug_y-corner_radius)]\npocket_points[5]=[(right_lug_x+rib*2,right_lug_y),(mid.X,mid.Y-rib),(mid.X-right_lug_radius,mid.Y+right_lug_radius),(right_lug_x+rib*2,valley_end.Y)]\npocket_points[6]=[(right_lug_x+right_lug_radius+rib,right_lug_y),(tip_center.X+wall,tip_center.Y-tip_radius/2+wall),(tip_center.X+wall,tip_center.Y+tip_radius),(mid.X+right_lug_radius,mid.Y+tip_radius),(mid.X+rib,mid.Y)]\nbody=extrude(outer_face,amount=overall_thickness,dir=(0,0,1))\nfor hx,hy,rr in [(left_lug_x,left_lug_y,left_lug_radius),(right_lug_x,right_lug_y,right_lug_radius)]:\n    body=body.fuse(Cylinder(rr,overall_thickness,align=(Align.CENTER,Align.CENTER,Align.MIN)).translate((hx,hy,0)))\nfor pts in pocket_points:\n    pf=rounded_face(pts,k_radius)\n    cutter=extrude(pf,amount=pocket_depth,dir=(0,0,1)).translate((0,0,floor_thickness)) & inner_volume\n    for hx,hy,hd in holes:\n        cutter=cutter-Cylinder(hd/2+wall/2,overall_thickness,align=(Align.CENTER,Align.CENTER,Align.MIN)).translate((hx,hy,0))\n    body=body-cutter\nfor hx,hy,hd in holes:\n    body=body-Cylinder(hd/2,overall_thickness,align=(Align.CENTER,Align.CENTER,Align.MIN)).translate((hx,hy,0))\n# Drill from a planar rail toward the interior. The start plane is outside the wall.\ncut_allowance=1.0 # mm\nside_hole_count_b=3\nside_hole_count_a=3\nside_hole_count_f=9\ndef rail_drill(shape,start,end,station,z,dia,depth=None):\n    a=Vector(start[0],start[1],0); b=Vector(end[0],end[1],0)\n    tangent=(b-a).normalized()\n    inward=Vector(tangent.Y,-tangent.X,0)\n    center=a+tangent*station+Vector(0,0,z)-inward*cut_allowance\n    cutdepth=wall*4 if depth is None else depth+cut_allowance\n    plane=Plane(origin=center,z_dir=inward)\n    tool=plane*Cylinder(dia/2,cutdepth,align=(Align.CENTER,Align.CENTER,Align.MIN))\n    return shape-tool\n# Ordered clockwise boundary segments ensure the normal points inward.\nfor i in range(side_hole_count_b):\n    body=rail_drill(body,outer_points[-1],outer_points[0],b_pitch*(i+1),b_z,d_side_b)\nfor i,station in enumerate([d_station,d_station+d_first_pitch,d_station+d_first_pitch+d_pitch,d_station+d_first_pitch+d_pitch*2,d_station+d_first_pitch+d_pitch*3,d_station+d_first_pitch+d_pitch*4,d_station+d_first_pitch+d_pitch*5]):\n    body=rail_drill(body,outer_points[1],outer_points[2],station,d_z,d_side_small,d_blind_depth if i in (3,4) else None)\nfor i in range(side_hole_count_a):\n    body=rail_drill(body,outer_points[3],outer_points[4],a_station+i*a_pitch,a_z,d_side_small)\nfor i in range(side_hole_count_f):\n    station=f_station+i*f_pitch+(f_gap if i>=4 else 0)\n    body=rail_drill(body,outer_points[6],outer_points[7],station+tip_radius,f_z,d_side_small)\nfor i in range(4):\n    body=rail_drill(body,outer_points[2],outer_points[3],e_station+i*e_pitch,e_small_z,d_side_small,None if i==0 else (e_blind_one if i==1 else e_blind_two))\nbody=rail_drill(body,outer_points[2],outer_points[3],valley_span-e_end,e_z,e_bore_d)\nbody=rail_drill(body,outer_points[8],outer_points[9],side_station,side_bore_z,d_side)\nresult=body\nshow(result,\"bracket\")\n"},"result":null,"error":null,"status":"in_progress"}}
