{"type":"item.started","item":{"id":"item_38","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"part=import_step(\"/var/folders/nc/sgtnd9hs0yjfrp26bcq3rwnr0000gn/T/cgb_fixture.X05iqD/output.step\")\npart=part.fuse(neck_outer).cut(neck_cut).fuse(sleeve)\npart=part.cut(Pos(zero,(neck_top+passage_bottom)/2,half_depth)*Rot(X=-right_angle)*Cylinder(passage_dia/2,neck_top-passage_bottom+2*overlap))\n# Front web relief: a shallow conical recess, with raised radial ribs added back.\nwith BuildPart() as relief:\n with BuildSketch(Plane.XZ):\n  Polygon((passage_boss_dia,-overlap),(ri,-overlap),(ri,web_front),\n   (passage_boss_dia,hub_front+rib_relief),align=None)\n revolve(axis=Axis.Z)\npart=part.cut(relief.part)\nwith BuildPart() as rib:\n with BuildSketch(Plane.XZ):\n  Polygon((passage_boss_dia-overlap,hub_front),(plateau_dia/2,hub_front),\n   (ri+overlap,junction_depth),(ri+overlap,half_depth+overlap),\n   (passage_boss_dia-overlap,half_depth+overlap),align=None)\n extrude(amount=rib_width/2,both=True)\nfor a in rib_angles:\n part=part.fuse(Rot(Z=a)*rib.part)\n# Rounded side tabs, buried into the shell\nfor sign in [-1,1]:\n tab_x=sign*(ri+tab_extension/2)\n tab=Pos(tab_x,zero,side_axis_depth/2)*Box(tab_extension,tab_inner_length+2*tab_fillet,side_axis_depth)\n tab=tab.fuse(Pos(tab_x,zero,side_axis_depth)*Rot(Y=right_angle)*Cylinder((tab_inner_length+2*tab_fillet)/2,tab_extension))\n part=part.fuse(tab)\nshow(part,\"housing\")\n"},"result":null,"error":null,"status":"in_progress"}}
