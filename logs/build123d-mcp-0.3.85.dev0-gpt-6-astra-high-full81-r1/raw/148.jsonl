{"type":"item.started","item":{"id":"item_53","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"pre_finish=part\n# The lower casting has a flat foot between its bottom mounting ears.\nfoot_bottom=-math.sqrt(external_typ**2-(foot_width/2)**2)\nfoot=Pos(zero,foot_bottom+shell_wall/2,half_depth)*Box(foot_width,shell_wall,axial_depth)\npart=part.fuse(foot)\n# Preserve lower mounting bores after joining the foot.\nfor a in mount_angles:\n x=bolt_pcd/2*math.cos(math.radians(a)); y=bolt_pcd/2*math.sin(math.radians(a))\n part=part.cut(Pos(x,y,half_depth)*Cylinder(mount_dia/2,axial_depth+2*overlap))\n# Internal rear taper at the printed 157.5 degree included angle.\nrear_taper_end=hub_back-(ri-plateau_dia/2)*math.tan(math.radians(half_turn-taper_angle))\nwith BuildPart() as rear_correct:\n with BuildSketch(Plane.XZ):\n  Polygon((counterbore_dia/2,hub_back),(plateau_dia/2,hub_back),\n   (ri,rear_taper_end),(ri,axial_depth+overlap),(counterbore_dia/2,axial_depth+overlap),align=None)\n revolve(axis=Axis.Z)\npart=part.cut(rear_correct.part)\n# Blend long outside contour junctions at R1.5, keeping the bore rims sharp.\nzedges=[e for e in part.edges().filter_by(Axis.Z) if abs(e.length-axial_depth)<overlap/100 and e.center().X**2+e.center().Y**2>(ro-overlap)**2]\nprint(\"outer axial blend candidates\",len(zedges))\ntry:\n part=fillet(zedges,radius=outer_fillet)\n print(\"outer blends applied\")\nexcept Exception as exc:\n print(\"outer blend skipped\",str(exc)[:150])\nshow(part,\"housing\")\n"},"result":null,"error":null,"status":"in_progress"}}
