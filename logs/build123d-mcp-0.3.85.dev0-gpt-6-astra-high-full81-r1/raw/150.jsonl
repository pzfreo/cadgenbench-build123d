_r_small,pocket_top),pt(detail_left-detail_r_small,pocket_top-detail_r_small,detail_r_small,math.pi/4),(detail_left,pocket_top-detail_r_small))\npocket_tool = extrude(Face(Wire(pocket_wire.edges())),amount=left_recess_depth+cut_margin,dir=(0,0,1)).translate((0,0,-left_recess_depth))\npart = part - pocket_tool\n# Slot dimensions give centre-to-centre spans.\nfor sx0,sx1 in [(slot1_end,slot1_start),(slot2_end,slot2_start)]:\n    slot_sk = Pos((sx0+sx1)/2,slot_y)*SlotCenterToCenter(sx1-sx0,slot_width)\n    slot_tool = extrude(slot_sk,amount=overall_thickness+cut_margin*2).translate((0,0,bottom_z-cut_margin))\n    part = part - slot_tool\npre_holes = part\n# Cylindrical thread representations, exact nominal diameters and table positions.\ndef blind_group(shape, coords, dia, start, depth, mouth_z=None, mouth_dia=None):\n    for x,y in coords:\n        upper = start if mouth_z is None else mouth_z\n        shape = shape - cyl_cut(x,y,dia,start-depth,upper+cut_margin)\n        if mouth_dia is not None and mouth_dia > dia and upper>start:\n            cone = Pos(x,y,start)*Cone(dia/2,mouth_dia/2,upper-start,align=(Align.CENTER,Align.CENTER,Align.MIN))\n            shape = shape - cone\n    return shape\npart = blind_group(part,m6_xy,m6_dia,m6_z,m6_depth,top_z)\npart = blind_group(part,small_cs_xy,small_drill_dia,upper_hole_z,small_drill_depth,-upper_recess_depth,small_cs_dia)\npart = blind_group(part,small_blind_xy,small_drill_dia,-upper_recess_depth,small_drill_depth)\npart = blind_group(part,m8_xy,m8_dia,m8_z,m8_depth,-channel_depth)\npart = blind_group(part,ring_xy,ring_drill_dia,ring_z,ring_drill_depth,-arm_depth,ring_cs_dia)\npart = blind_group(part,mount_xy,mount_drill_dia,upper_hole_z,mount_drill_depth,-upper_recess_depth,mount_cs_dia)\npart = blind_group(part,m10_detail_xy,m10_dia,m10_z_left,m10_depth_short,-left_recess_depth)\npart = blind_group(part,m10_shelf_xy,m10_dia,m10_z_left,m10_depth_long,-left_recess_depth)\npart = blind_group(part,m10_channel_xy,m10_dia,m