10_channel_xy = [(168.20,84.90),(120.20,84.90),(72.20,84.90),(24.20,84.90),(216.20,29.90),(168.20,29.90),(120.20,29.90),(72.20,29.90),(24.20,29.90)]\nlarge_blind_xy = [(590.00,160.73),(545.05,160.68),(635.06,160.65),(545.02,135.84),(634.91,135.67),(590.00,135.67)]\ndetail_blind_xy = [(442.50,157.15)]\n# Stacked-span chains:\n# Z: top=0; bottom=-40; rail top=bottom+18.7=-21.3; rail relief=40-18.7.\n# Z: cbore cylindrical start=-1.1; shoulder=-1.1-20=-21.1; base remaining=40-21.1.\n# Y: channel span=109.9-14.9; tab span=164.9-154.9.\n# X: overall plan envelope=650+15=665. Side printed chain=649.6+15=664.6.\n# Use authoritative plan datum and table locations; 0.4 discrepancy is recorded.\ntop_z = 0.0 # mm datum\nbottom_z = -overall_thickness\ncut_margin = 1.0 # mm numerical boolean extension\nrail_top = bottom_z + rail_height\n# analytic tangent arc pair on lower outer contour\nblend_theta = math.acos(1-left_lower_edge/(lower_radius+neck_radius))\nlower_end_x = bore_x\nlower_join_x = lower_end_x+lower_radius*math.sin(blend_theta)\nlower_join_y = lower_radius*(1-math.cos(blend_theta))\nneck_start_x = lower_end_x+(lower_radius+neck_radius)*math.sin(blend_theta)\nupper_break_x = upper_recess_left+(overall_width-left_top)/math.tan(math.radians(180-upper_angle))\ndef pt(cx,cy,r,a):\n    return (cx+r*math.cos(a),cy+r*math.sin(a))\nwith BuildLine() as outline:\n    Polyline((0,0),(lower_end_x,0))\n    ThreePointArc((lower_end_x,0),pt(lower_end_x,lower_radius,lower_radius,-math.pi/2+blend_theta/2),(lower_join_x,lower_join_y))\n    ThreePointArc((lower_join_x,lower_join_y),pt(neck_start_x,left_lower_edge-neck_radius,neck_radius,math.pi/2+blend_theta/2),(neck_start_x,left_lower_edge))\n    Polyline((neck_start_x,left_lower_edge),(datum_length-left_bottom_chamfer,left_lower_edge),(datum_length,left_lower_edge+left_bottom_chamfer),(datum_length,left_top-left_top_chamfer),(datum_length-left_top_chamfer,left_top),(upper_break_x,left_top),(upper_recess_left,overall_width),(0,overall_width),(0,upper_recess_bottom),(-tab_extension,upper_recess_bottom),(-tab_extension,tab_bottom),(0,tab_bottom),(0,0))\noutline_face = Face(Wire(outline.edges()))\npart = extrude(outline_face, amount=overall_thickness).translate((0,0,bottom_z))\ndef rect_cut(x0,x1,y0,y1,z0,z1):\n    return Pos(x0,y0,z0)*Box(x1-x0,y1-y0,z1-z0,align=(Align.MIN,Align.MIN,Align.MIN))\n# Primary depth profile first: left shelf, upper ledges, long tray, lowered front rail.\npart = part - rect_cut(left_step_x,datum_length+cut_margin,left_shelf_front,overall_width+cut_margin,-left_recess_depth,cut_margin)\npart = part - rect_cut(upper_recess_right,upper_recess_left,upper_recess_bottom,overall_width+cut_margin,-upper_recess_depth,cut_margin)\npart = part - rect_cut(-cut_margin,end_recess_width,upper_recess_bottom,overall_width+cut_margin,-upper_recess_depth,cut_margin)\npart = part - rect_cut(-cut_margin,channel_length,channel_front,channel_back,-channel_depth,cut_margin)\npart = part - rect_cut(rail_cut_start,rail_cut_end,-cut_margin,channel_front+cut_margin,rail_top,cut_margin)\n# Counterbore shoulder and through bore, before small holes\ndef cyl_cut(x,y,d,zlo,zhi):\n    return Pos(x,y,zlo)*Cylinder(d/2,zhi-zlo,align=(Align.CENTER,Align.CENTER,Align.MIN))\npart = part - cyl_cut(bore_x,bore_y,counterbore_dia,through_start,cut_margin)\npart = part - cyl_cut(bore_x,bore_y,through_dia,bottom_z-cut_margin,cut_margin)\n# Two radial rectangular reliefs into counterbore\nfor angle in (90-arm_angle_from_vertical,90+arm_angle_from_vertical):\n    arm = Pos(0,-arm_width/2,-arm_depth)*Box(arm_radius,arm_width,arm_depth+cut_margin,align=(Align.MIN,Align.MIN,Align.MIN))\n    part = part - arm.rotate(Axis.Z,angle).translate((bore_x,bore_y,0))\nshow(part,\"part\")\n"},"result":null,"error":null,"status":"in_progress"}}
