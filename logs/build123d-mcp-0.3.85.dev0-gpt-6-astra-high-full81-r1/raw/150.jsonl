{"type":"item.started","item":{"id":"item_53","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"\n# Thread-hole cylinder sizes derived from the printed chamfer/start offsets.\nm6_tap_dia = m6_dia-2*(top_z-m6_z) # mm = 5\nm8_tap_dia = m8_dia-2*(-channel_depth-m8_z) # mm = 6.8\nm10_tap_dia = m10_dia-2*(-left_recess_depth-m10_z_left) # mm = 8.5\nside_small_tap_dia = 10.2 # mm, standard M12x1.75 tap drill\nside_large_tap_dia = side_large_dia-side_large_pitch # mm\npart = refined_blank - (old_blank-pre_holes)\npart = refined_blank - ((refined_blank-part)-pocket_tool) - smooth_pocket_tool\npart = blind_group(part,m6_xy,m6_tap_dia,m6_z,m6_depth,top_z,m6_dia)\npart = blind_group(part,small_cs_xy,small_drill_dia,upper_hole_z,small_drill_depth,-upper_recess_depth,small_cs_dia)\npart = blind_group(part,small_blind_xy,small_drill_dia,-upper_recess_depth,small_drill_depth)\npart = blind_group(part,m8_xy,m8_tap_dia,m8_z,m8_depth,-channel_depth,m8_dia)\npart = blind_group(part,ring_xy,ring_drill_dia,ring_z,ring_drill_depth,-arm_depth,ring_cs_dia)\npart = blind_group(part,mount_xy,mount_drill_dia,upper_hole_z,mount_drill_depth,-upper_recess_depth,mount_cs_dia)\npart = blind_group(part,m10_detail_xy,m10_tap_dia,m10_z_left,m10_depth_short,-left_recess_depth,m10_dia)\npart = blind_group(part,m10_shelf_xy,m10_tap_dia,m10_z_left,m10_depth_long,-left_recess_depth,m10_dia)\npart = blind_group(part,m10_channel_xy,m10_tap_dia,m10_z_channel,m10_depth_short,-channel_depth,m10_dia)\npart = blind_group(part,large_blind_xy,large_drill_dia,large_drill_z,large_drill_depth,-left_recess_depth)\nfor hx,hy,hz,hd,major,hdepth in [(side_small_x,left_lower_edge,bottom_z+side_small_height,side_small_tap_dia,side_small_dia,side_small_depth),(side_large_x,0,bottom_z+side_large_height,side_large_tap_dia,side_large_dia,side_large_depth)]:\n    side_tool = Cylinder(hd/2,hdepth+cut_margin,align=(Align.CENTER,Align.CENTER,Align.MIN)).rotate(Axis.X,-90).translate((hx,hy-cut_margin,hz))\n    side_cs = Cone(major/2,hd/2,(major-hd)/2,align=(Align.CENTER,Align.CENTER,Align.MIN)).rotate(Axis.X,-90).translate((hx,hy,hz))\n    part = part - side_tool - side_cs\nshow(part,\"part\")\n"},"result":null,"error":null,"status":"in_progress"}}
