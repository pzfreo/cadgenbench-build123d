{"type":"item.started","item":{"id":"item_25","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"import numpy as np\nsupport_extended = support.Copy()\nv_extension = -0.01\nfor i in range(1,support.NbUPoles()+1):\n    h=[]\n    for j in (1,2,3):\n        p=support.Pole(i,j); w=support.Weight(i,j)\n        h.append(np.array([p.X()*w,p.Y()*w,p.Z()*w,w]))\n    ext=[(1-v_extension)**2*h[0]+2*v_extension*(1-v_extension)*h[1]+v_extension**2*h[2], (1-v_extension)*h[1]+v_extension*h[2], h[2]]\n    for j,q in enumerate(ext,1):\n        support_extended.SetPole(i,j,gp_Pnt(*(q[:3]/q[3])),float(q[3]))\nsupport_extended.SetVKnot(1,v_extension)\nprint('extended bounds',support_extended.Bounds(),'max deviation',max(support.Value(u,v).Distance(support_extended.Value(u,v)) for u in (0,.25,.5,.75,1) for v in (-.0005,0,.25,.5,.75,1)))\nspline_mk=BRepBuilderAPI_MakeFace(support_extended,spline_bad.outer_wire().wrapped,True)\nassert spline_mk.IsDone()\nspline_patch=Face(spline_mk.Face())\nspline_patch.wrapped.Orientation(spline_bad.wrapped.Orientation())\n# Reapply both independently diagnosed repairs directly to the original.\nrs=BRepTools_ReShape()\nrs.Replace(bad_arc.wrapped,chord.wrapped)\nrs.Replace(spline_bad.wrapped,spline_patch.wrapped)\nraw_repaired=Solid(TopoDS.Solid_s(rs.Apply(original.wrapped)))\nlocal_rs=BRepTools_ReShape()\nfor orig_f in (bad_face,original.faces()[2091]):\n    local_f=TopoDS.Face_s(rs.Apply(orig_f.wrapped))\n    local_fix=ShapeFix_Face(local_f)\n    local_fix.SetPrecision(0.001)\n    local_fix.SetMaxTolerance(0.001)\n    local_fix.Perform()\n    local_rs.Replace(local_f,local_fix.Face())\nrepair3=Solid(TopoDS.Solid_s(local_rs.Apply(raw_repaired.wrapped)))\nshow(repair3,'repair3')\nprint('volume delta',repair3.volume-original.volume)"},"result":null,"error":null,"status":"in_progress"}}
