{"type":"item.started","item":{"id":"item_13","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"import inspect\nprint('defeature methods', [s for s in dir(part) if any(k in s for k in ('remove','split','replace'))])\nprint(inspect.signature(part.remove)) if hasattr(part,'remove') else None\nfrom OCP.BRepAdaptor import BRepAdaptor_Surface\nfor i in [145,146,147,148,149,150,154]:\n    a=BRepAdaptor_Surface(faces[i].wrapped)\n    if faces[i].geom_type == GeomType.TORUS:\n        t=a.Torus(); print(i,'torus',vround(t.Location().Coord()),vround(t.Axis().Direction().Coord()),t.MajorRadius(),t.MinorRadius(), 'UV',a.FirstUParameter(),a.LastUParameter(),a.FirstVParameter(),a.LastVParameter())\n# Bounded adjacency grouping: blade surfaces are all faces other than main hub surfaces 145..155.\nedge_sets=[list(f.edges()) for f in faces]\nadj={i:set() for i in range(len(faces))}\nfor i in range(len(faces)):\n    for j in range(i+1,len(faces)):\n        if any(e.is_same(g) for e in edge_sets[i] for g in edge_sets[j]): adj[i].add(j); adj[j].add(i)\nremaining=set(range(145)); blade_groups=[]\nwhile remaining:\n    group={min(remaining)}; stack=list(group)\n    while stack:\n        for j in adj[stack.pop()] & remaining - group: group.add(j); stack.append(j)\n    remaining-=group; blade_groups.append(sorted(group))\nprint('blade groups',blade_groups)\nfor g in blade_groups:\n    big=[i for i in g if faces[i].area>10000]\n    print('group',big,'faces',len(g),'boundary adjacency',sorted(set.union(*(adj[i] for i in g))-set(g)))\nshow(part,'part')"},"result":null,"error":null,"status":"in_progress"}}
