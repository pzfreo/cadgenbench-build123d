{"type":"item.started","item":{"id":"item_25","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"# Discard the failed defeature; work only from original faces.\nfrom OCP.BRep import BRep_Tool\nfrom OCP.BRepBuilderAPI import BRepBuilderAPI_MakeFace\nfrom OCP.TopoDS import TopoDS\n# Extend existing analytic faces in their native UV coordinates; no surface refit.\ndef extend_face_uv(source,u0,u1,v0,v1):\n    raw=BRepBuilderAPI_MakeFace(BRep_Tool.Surface_s(source.wrapped),u0,u1,v0,v1,1e-7).Face()\n    raw.Orientation(source.wrapped.Orientation())\n    return Face(raw)\nmain_adaptor=BRepAdaptor_Surface(faces[146].wrapped)\nsmall_adaptor=BRepAdaptor_Surface(faces[55].wrapped)\nmain_full=extend_face_uv(faces[146],0,2*math.pi,main_adaptor.FirstVParameter(),main_adaptor.LastVParameter())\nsmall_full=extend_face_uv(faces[55],0,2*math.pi,small_adaptor.FirstVParameter(),small_adaptor.LastVParameter())\n# The toroidal surface meets the original outer cylinder at this exact height.\nouter_join_z=main_adaptor.Value(0,main_adaptor.FirstVParameter()).Z()\ntop_z=faces[148].center().Z\nouter_full=extend_face_uv(faces[147],0,2*math.pi,outer_join_z-top_z,0)\n# Cap the extended lower root blend with the original bore boundary.\nsmall_bottom_edges=[e for e in small_full.edges() if abs(e.center().Z-faces[145].center().Z)<1e-5 and e.geom_type==GeomType.CIRCLE]\nprint('bottom boundary circles',len(small_bottom_edges),[(e.radius,e.center().Z) for e in small_bottom_edges])\nbore_bottom_edges=[e for e in faces[149].edges() if e.geom_type==GeomType.CIRCLE and abs(e.center().Z-faces[145].center().Z)<1e-5]\nbottom_full=Face(Wire(small_bottom_edges),[Wire(bore_bottom_edges)])\nif bottom_full.normal_at().Z>0: bottom_full=-bottom_full\nhub_envelope=Solid(Shell([faces[148],faces[149],outer_full,main_full,small_full,bottom_full]))\nprint('outer join z',outer_join_z,'top',top_z)\nshow(hub_envelope,'hub_envelope')"},"result":null,"error":null,"status":"in_progress"}}
