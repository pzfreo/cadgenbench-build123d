{"type":"item.started","item":{"id":"item_13","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"from OCP.BRepAdaptor import BRepAdaptor_Surface\nfaces = list(part.faces())\ndef brief_face(f):\n    a = BRepAdaptor_Surface(f.wrapped)\n    d = {'index':next((i for i,g in enumerate(faces) if f.is_same(g)),None), 'type':str(f.geom_type), 'center':tuple(f.center()), 'area':f.area, 'loops':len(f.wires()), 'bounds':(tuple(f.bounding_box().min),tuple(f.bounding_box().max))}\n    if f.geom_type == GeomType.CYLINDER:\n        c=a.Cylinder(); d.update(radius=c.Radius(), axis=c.Axis().Direction().Coord(), origin=c.Location().Coord())\n    if f.geom_type == GeomType.PLANE: d['normal']=tuple(f.normal_at())\n    return d\nfor h in [1,16,17,18]:\n    fs=recognition_faces(f'@feature[r1/holes/{h}]')\n    print('CANDIDATE',h)\n    for f in fs:\n        print(brief_face(f))\n        adjacent=[g for g in faces if not g.is_same(f) and any(e.is_same(ge) for e in f.edges() for ge in g.edges())]\n        print('ADJACENT', [brief_face(g) for g in adjacent])\nprint('ANNULAR PLANES')\nfor f in faces:\n    if f.geom_type==GeomType.PLANE and len(f.wires())==2 and all(e.geom_type==GeomType.CIRCLE for e in f.edges()):\n        print(brief_face(f), 'circles',[(e.radius,tuple(e.arc_center)) for e in f.edges()])"},"result":null,"error":null,"status":"in_progress"}}
