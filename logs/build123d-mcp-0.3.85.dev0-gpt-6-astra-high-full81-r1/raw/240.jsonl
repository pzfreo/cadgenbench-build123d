{"type":"item.started","item":{"id":"item_13","type":"mcp_tool_call","server":"build123d","tool":"execute","arguments":{"code":"from OCP.ShapeFix import ShapeFix_Face\nfrom OCP.BRepTools import BRepTools_ReShape\nfrom OCP.TopoDS import TopoDS\noriginal = part\nshow(original, 'original')\nbad_face = part.faces()[689]\nprint('bad face', bad_face.center(), bad_face.area)\nface_fix = ShapeFix_Face(bad_face.wrapped)\nface_fix.Perform()\nrs = BRepTools_ReShape()\nrs.Replace(bad_face.wrapped, face_fix.Face())\nrepaired = Solid(TopoDS.Solid_s(rs.Apply(part.wrapped)))\nshow(repaired, 'repaired')\nprint('repair volume delta', repaired.volume-original.volume)"},"result":null,"error":null,"status":"in_progress"}}
