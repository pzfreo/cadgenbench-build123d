#!/usr/bin/env bash
set -euo pipefail

joined=" $* "
if [[ "$joined" != *" --resume recognition-test-session "* ]]; then
  [[ "$joined" == *"Mandatory repair-first recognition preflight"* ]] || {
    echo "missing repair-first recognition preflight prompt" >&2
    exit 2
  }
  printf '%s\n' '{"type":"system","subtype":"init","session_id":"recognition-test-session"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"import","name":"mcp__build123d__import_cad_file","input":{"path":"input.step","name":"part"}}]},"session_id":"recognition-test-session"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"inventory","name":"mcp__build123d__recognise_features","input":{"object_name":"part"}}]},"session_id":"recognition-test-session"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"targeted","name":"mcp__build123d__recognise_features","input":{"object_name":"part","families":"holes"}}]},"session_id":"recognition-test-session"}'
  printf '%s\n' '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"targeted","content":"{\"result\":\"{\\\"matched\\\":1,\\\"returned\\\":1}\"}"}]},"session_id":"recognition-test-session"}'
  printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"resolve","name":"mcp__build123d__execute","input":{"code":"faces = recognition_faces(\"@feature[r1/holes/0]\")"}}]},"session_id":"recognition-test-session"}'
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"preflight complete","session_id":"recognition-test-session"}'
  # Claude Code sometimes does this in real runs; the harness must trust the
  # explicit successful terminal event rather than skipping the audit.
  exit 1
fi

[[ "$joined" == *"mandatory recognition preflight passed"* ]] || {
  echo "missing resumed edit-execution prompt" >&2
  exit 3
}
printf 'ISO-10303-21;\nEND-ISO-10303-21;\n' > output.step
printf '%s\n' '{"type":"system","subtype":"init","session_id":"recognition-test-session"}'
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"edited and exported","session_id":"recognition-test-session"}'
